/* Generated from tokens.json (direction: committed-field) — do not hand-edit;
   change the spec/direction and regenerate. */
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: {{font.ui}};
  background: {{color.ground}};
  color: {{color.ink}};
  font-size: {{type.body}}px;
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
}
button { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }
button:focus-visible, input:focus-visible { outline: 3px solid {{color.brand}}; outline-offset: 2px; }
[hidden] { display: none !important; }
.vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* ---------- hero field ---------- */
.hero { background: {{color.field}}; color: {{color.fieldText}}; padding: 18px 20px 64px; }
.hero-inner, .sheet-inner, .bag-main, .confirm-main { max-width: 1060px; margin: 0 auto; }
.brand-row { display: flex; justify-content: space-between; align-items: center; }
.brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 17px; }
.brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: {{color.fieldText}}; color: {{color.brand}}; font-family: {{font.display}}; font-size: 19px; }
.location { opacity: 0.92; font-size: {{type.small}}px; display: inline-flex; align-items: center; gap: 5px; }
.bag-btn { background: rgba(255,255,255,0.16); color: {{color.fieldText}}; border-radius: {{radius.pill}}px; padding: 8px 16px; font-weight: 600; }
.tagline { font-family: {{font.display}}; font-size: {{type.display}}px; line-height: 1.08; margin: 26px 0 8px; font-weight: 700; }
.tagline-sub { margin: 0 0 20px; opacity: 0.92; max-width: 420px; }
.search { display: flex; align-items: center; gap: 10px; background: {{color.surface}}; color: {{color.ink}}; border-radius: {{radius.pill}}px; padding: 13px 18px; max-width: 520px; box-shadow: {{shadow.search}}; }
.search input { border: 0; outline: none; font: inherit; flex: 1; background: none; color: {{color.ink}}; }
.search input::placeholder { color: {{color.inkSoft}}; }

/* ---------- sheet ---------- */
.sheet { background: {{color.ground}}; border-radius: {{radius.sheet}}px {{radius.sheet}}px 0 0; margin-top: -34px; padding: 22px 20px 96px; box-shadow: {{shadow.sheet}}; }
.cats { display: flex; gap: 18px; overflow-x: auto; padding: 4px 2px 10px; }
.chip { display: flex; flex-direction: column; align-items: center; gap: 7px; flex: 0 0 auto; font-size: {{type.small}}px; font-weight: 600; }
.chip-dot { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; background: {{state.chipOff.bg}}; color: {{state.chipOff.fg}}; font-family: {{font.display}}; font-size: 20px; box-shadow: {{shadow.chip}}; transition: background 0.15s ease, color 0.15s ease; }
.chip-on .chip-dot { background: {{state.chipOn.bg}}; color: {{state.chipOn.fg}}; }
.chip-on .chip-label { color: {{color.brand}}; }

/* ---------- promo ---------- */
.promo { display: flex; align-items: center; gap: 0; background: {{color.board}}; color: {{color.onBrand}}; border-radius: {{radius.card}}px; overflow: hidden; margin: 14px 0 26px; }
.promo-visual { flex: 0 0 42%; display: grid; place-items: center; padding: 10px; }
.promo-visual svg { width: 100%; max-width: 300px; height: auto; }
.promo-text { padding: 20px 18px; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
.promo-text h2 { font-family: {{font.display}}; font-size: 22px; margin: 0; line-height: 1.15; }
.promo-text p { margin: 0; opacity: 0.85; font-size: {{type.small}}px; }
.promo-badge { margin-top: 8px; background: {{color.cert}}; color: {{color.onBrand}}; border-radius: {{radius.pill}}px; padding: 5px 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.02em; }

/* ---------- product grid ---------- */
.section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; }
.section-title { font-size: {{type.section}}px; margin: 0; font-weight: 700; }
.section-note { color: {{color.inkSoft}}; font-size: {{type.small}}px; }
.grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
.card { background: {{color.surface}}; border-radius: {{radius.card}}px; overflow: hidden; box-shadow: {{shadow.card}}; display: flex; flex-direction: column; }
.card-visual { position: relative; display: block; width: 100%; background: {{color.board}}; padding: 14px 10px 8px; }
.card-visual svg { width: 100%; height: auto; display: block; }
.badge { position: absolute; top: 10px; left: 10px; background: {{state.badge.bg}}; color: {{state.badge.fg}}; border-radius: {{radius.pill}}px; padding: 4px 10px; font-size: 11px; font-weight: 700; }
.badge-static { position: static; display: inline-block; margin-bottom: 8px; }
.card-body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 3px; flex: 1; }
.card-name { font-family: {{font.display}}; font-size: {{type.productName}}px; margin: 0; line-height: 1.15; }
.stars { color: {{color.star}}; font-size: 13px; letter-spacing: 1px; }
.stars-num { color: {{color.ink}}; font-weight: 700; margin-left: 5px; letter-spacing: 0; }
.reviews { color: {{color.inkSoft}}; font-size: {{type.small}}px; margin-left: 5px; }
.card-row { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 8px; }
.price { font-size: {{type.price}}px; font-weight: 700; }
.per { color: {{color.inkSoft}}; font-weight: 500; font-size: {{type.small}}px; }
.add-btn { width: {{radius.addBtn}}px; height: {{radius.addBtn}}px; border-radius: 50%; background: {{state.cta.bg}}; color: {{state.cta.fg}}; font-size: 21px; line-height: 1; display: grid; place-items: center; transition: background 0.15s ease, transform 0.1s ease; }
.add-btn:hover { background: {{state.cta.hoverBg}}; }
.add-btn:active { transform: scale(0.92); }
.no-results { grid-column: 1 / -1; color: {{color.inkSoft}}; padding: 24px 0; }

/* ---------- detail ---------- */
.sub-bar { display: flex; align-items: center; gap: 14px; padding: 14px 20px; max-width: 1060px; margin: 0 auto; }
.back-btn { width: 40px; height: 40px; border-radius: 50%; background: {{color.surface}}; box-shadow: {{shadow.card}}; font-size: 18px; display: grid; place-items: center; }
.sub-title { font-weight: 700; font-size: 17px; margin: 0; }
.detail-visual { background: {{color.board}}; padding: 8px 20px 64px; display: grid; place-items: center; }
.detail-visual svg { width: min(440px, 86vw); height: auto; }
.detail-sheet { background: {{color.surface}}; border-radius: {{radius.sheet}}px {{radius.sheet}}px 0 0; margin-top: -34px; padding: 24px 20px 96px; box-shadow: {{shadow.sheet}}; max-width: 1060px; margin-left: auto; margin-right: auto; }
.detail-name { font-family: {{font.display}}; font-size: 30px; margin: 0 0 4px; }
.detail-price { font-size: 22px; font-weight: 800; margin: 10px 0 6px; }
.blurb { color: {{color.inkSoft}}; max-width: 560px; margin: 4px 0 16px; }
.features { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 22px; padding: 0; margin: 0 0 22px; font-size: {{type.small}}px; font-weight: 600; }
.features li { display: flex; align-items: center; gap: 7px; }
.feat-dot { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: {{color.tint}}; color: {{color.brand}}; font-size: 12px; }
.feat-cert { background: {{color.cert}}; color: {{color.onBrand}}; }
.buy-row { display: flex; gap: 14px; align-items: stretch; flex-wrap: wrap; }
.stepper { display: flex; align-items: center; gap: 4px; border: 1.5px solid {{state.stepper.line}}; border-radius: {{radius.pill}}px; padding: 4px; background: {{state.stepper.bg}}; }
.stepper button { width: 40px; height: 40px; border-radius: 50%; font-size: 19px; display: grid; place-items: center; }
.stepper button:hover { background: {{color.tint}}; }
.qty-value { min-width: 56px; text-align: center; font-weight: 700; }
.stepper-sm button { width: 32px; height: 32px; font-size: 16px; }
.stepper-sm span { min-width: 30px; text-align: center; font-weight: 700; }
.cta { background: {{state.cta.bg}}; color: {{state.cta.fg}}; border-radius: {{radius.pill}}px; padding: 14px 26px; font-weight: 700; font-size: 16px; transition: background 0.15s ease; flex: 1; }
.cta:hover { background: {{state.cta.hoverBg}}; }
.cta-wide { width: 100%; margin-top: 18px; }
.also-row { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 6px; }
.also-card { flex: 0 0 148px; background: {{color.ground}}; border-radius: {{radius.card}}px; padding: 10px; display: flex; flex-direction: column; gap: 4px; text-align: left; font-weight: 600; font-size: {{type.small}}px; }
.also-card svg { width: 100%; height: auto; background: {{color.board}}; border-radius: 12px; }
.also-price { color: {{color.brand}}; font-weight: 700; }

/* ---------- bag ---------- */
.bag-main { padding: 6px 20px 110px; }
.bag-items { display: flex; flex-direction: column; gap: 12px; }
.bag-item { display: grid; grid-template-columns: 76px 1fr auto; gap: 6px 14px; align-items: center; background: {{color.surface}}; border-radius: {{radius.card}}px; padding: 12px 14px; box-shadow: {{shadow.card}}; }
.bag-thumb { background: {{color.board}}; border-radius: 12px; padding: 6px; }
.bag-thumb svg { width: 100%; height: auto; display: block; }
.bag-info h2 { font-family: {{font.display}}; font-size: 17px; margin: 0 0 2px; }
.bag-unit { color: {{color.inkSoft}}; font-size: {{type.small}}px; }
.bag-line { grid-column: 3; font-weight: 800; text-align: right; }
.totals { margin-top: 20px; background: {{color.surface}}; border-radius: {{radius.card}}px; padding: 16px; box-shadow: {{shadow.card}}; }
.totals > div { display: flex; justify-content: space-between; padding: 5px 0; }
.totals-grand { border-top: 1px dashed {{color.line}}; margin-top: 8px; padding-top: 12px !important; font-weight: 800; font-size: 17px; }
.empty { text-align: center; padding: 64px 20px; }
.empty-mark { font-size: 44px; }
.empty h2 { font-family: {{font.display}}; }
.empty p { color: {{color.inkSoft}}; }
.empty .cta { flex: none; margin-top: 10px; }

/* ---------- confirmation ---------- */
.confirm-main { text-align: center; padding: 72px 20px 110px; }
.confirm-mark { width: 76px; height: 76px; margin: 0 auto 18px; border-radius: 50%; background: {{color.cert}}; color: {{color.onBrand}}; font-size: 36px; display: grid; place-items: center; }
.confirm-h { font-family: {{font.display}}; font-size: 30px; margin: 0 0 8px; }
.confirm-ref { font-size: 17px; }
.confirm-note { color: {{color.inkSoft}}; margin-bottom: 22px; }
.confirm-main .cta { flex: none; }

/* ---------- tab bar ---------- */
.tabbar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; background: {{color.surface}}; border-top: 1px solid {{color.line}}; padding: 8px 12px calc(8px + env(safe-area-inset-bottom)); z-index: 10; }
.tab { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 12px; font-weight: 600; color: {{state.tabIdle.fg}}; border-radius: 12px; padding: 6px 0; position: relative; }
.tab-ico { font-size: 19px; }
.tab-on { color: {{state.tabActive.fg}}; }
.bag-count { background: {{color.brand}}; color: {{color.onBrand}}; border-radius: {{radius.pill}}px; min-width: 20px; height: 20px; display: inline-grid; place-items: center; font-size: 11px; padding: 0 5px; }
.tab .bag-count { position: absolute; top: 0; right: calc(50% - 24px); }
.bag-count.bump { animation: bump 0.3s ease; }
@keyframes bump { 40% { transform: scale(1.35); } }
@media (prefers-reduced-motion: reduce) { .bag-count.bump { animation: none; } .add-btn:active { transform: none; } }

/* ---------- desktop ---------- */
.desktop-only { display: none; }
@media (min-width: 900px) {
  .grid { grid-template-columns: repeat(4, 1fr); }
  .tagline { font-size: 46px; }
  .tabbar { display: none; }
  .desktop-only { display: inline-flex; align-items: center; gap: 8px; }
  .sheet, .detail-sheet { padding-bottom: 48px; }
  .bag-main, .confirm-main { padding-bottom: 48px; }
}

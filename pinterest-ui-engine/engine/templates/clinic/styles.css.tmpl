/* CarePoint — generated from tokens.json + families/clinic.json
   (neutral-gallery direction).

   Mission 020 note: this file used to open with an apology. Three pipeline
   findings were worked around here with hardcoded hexes — the ground
   (#F4F7FB), the error colour (#C62F3B) and the input surface (#EDF1F8) —
   because make_tokens had a white ground, no error role and a warm hairline
   leaked from the butcher run. Those are now declared in families/clinic.json
   and gated by make_tokens, so every colour below comes from a token. */
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body { font-family: {{font.ui}}; background: {{color.ground}}; color: {{color.ink}}; font-size: {{type.body}}px; line-height: 1.45; -webkit-font-smoothing: antialiased; }
button { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }
button:focus-visible, input:focus-visible { outline: 3px solid {{color.brand}}; outline-offset: 2px; }
[hidden] { display: none !important; }
.vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.wrap { max-width: 1060px; margin: 0 auto; padding: 0 20px; }

/* header */
.topbar { background: {{color.surface}}; border-bottom: 1px solid {{color.line}}; }
.topbar-in { display: flex; justify-content: space-between; align-items: center; padding-top: 13px; padding-bottom: 13px; }
.brand { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 17px; }
.brand-mark { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; background: {{color.brand}}; }
.location { color: {{color.inkSoft}}; font-size: {{type.small}}px; display: inline-flex; align-items: center; gap: 5px; }

/* home */
.home-main { padding-top: 20px; padding-bottom: 96px; }
.page-title { font-size: {{type.display}}px; margin: 0 0 4px; letter-spacing: -0.01em; }
.page-sub { color: {{color.inkSoft}}; margin: 0 0 16px; }
.search { display: flex; align-items: center; gap: 9px; background: {{color.input}}; color: {{color.inkSoft}}; border-radius: 12px; padding: 12px 14px; max-width: 560px; }
.search input { border: 0; outline: none; background: none; font: inherit; flex: 1; color: {{color.ink}}; }
.search input::placeholder { color: {{color.inkSoft}}; }
.specs { display: flex; gap: 8px; overflow-x: auto; padding: 16px 2px 6px; }
.spec-chip { flex: 0 0 auto; border: 1.5px solid {{color.line}}; background: {{state.chipOff.bg}}; color: {{state.chipOff.fg}}; border-radius: {{radius.pill}}px; padding: 8px 15px; font-weight: 600; font-size: 13px; }
.spec-on { background: {{state.badge.bg}}; color: {{state.badge.fg}}; border-color: {{color.brand}}; }
.section-head { display: flex; justify-content: space-between; align-items: baseline; margin: 18px 0 12px; }
.section-title { font-size: {{type.section}}px; margin: 24px 0 10px; }
.section-head .section-title { margin: 0; }
.section-note { color: {{color.inkSoft}}; font-size: {{type.small}}px; }
.upcoming { background: {{state.badge.bg}}; border: 1px solid {{color.brand}}; border-radius: {{radius.card}}px; padding: 14px 16px; margin-top: 16px; display: flex; flex-direction: column; gap: 2px; }
.upcoming-label { color: {{state.badge.fg}}; font-weight: 800; font-size: {{type.small}}px; text-transform: uppercase; letter-spacing: 0.06em; }
.upcoming-main { font-weight: 700; }
.upcoming-when { color: {{color.ink}}; font-size: 13px; }
.doctors { display: flex; flex-direction: column; gap: 12px; }
.doc-card { display: flex; gap: 14px; width: 100%; text-align: left; background: {{color.surface}}; border: 1px solid {{color.line}}; border-radius: {{radius.card}}px; padding: 14px; box-shadow: {{shadow.card}}; transition: border-color 0.15s ease; }
.doc-card:hover { border-color: {{color.brand}}; }
.avatar { flex: 0 0 auto; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: {{state.badge.bg}}; color: {{state.badge.fg}}; font-weight: 800; font-size: 16px; }
.avatar-lg { width: 76px; height: 76px; font-size: 23px; }
.doc-main { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.doc-top { display: flex; justify-content: space-between; align-items: center; }
.doc-name { font-size: {{type.doctorName}}px; font-weight: 700; }
.chev { color: {{color.inkSoft}}; font-size: 20px; }
.doc-spec { color: {{color.inkSoft}}; font-size: 13px; }
.doc-spec-lg { color: {{color.inkSoft}}; margin: 2px 0 0; }
.doc-meta { display: flex; align-items: center; gap: 5px; font-size: 13px; font-weight: 600; margin-top: 3px; flex-wrap: wrap; }
.stars { color: {{color.star}}; }
.stars-num { color: {{color.ink}}; margin-left: 2px; }
.reviews { color: {{color.inkSoft}}; font-weight: 500; }
.dot { color: {{color.inkSoft}}; }
.no-results { color: {{color.inkSoft}}; padding: 18px 0; }

/* detail */
.sub-bar { display: flex; align-items: center; gap: 14px; padding-top: 14px; }
.back-btn { width: 40px; height: 40px; border-radius: 50%; background: {{color.surface}}; border: 1px solid {{color.line}}; font-size: 17px; display: grid; place-items: center; }
.sub-title { font-weight: 700; font-size: 16px; margin: 0; }
.detail-main { padding-bottom: 96px; }
.doc-hero { background: {{color.surface}}; border: 1px solid {{color.line}}; border-radius: {{radius.card}}px; padding: 20px; margin-top: 14px; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; box-shadow: {{shadow.card}}; }
.detail-name { font-size: {{type.detailName}}px; margin: 10px 0 0; }
.stats { display: flex; gap: 0; margin-top: 14px; width: 100%; border-top: 1px solid {{color.line}}; padding-top: 12px; }
.stats span { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 1px; }
.stats strong { font-size: 15px; }
.stats small { color: {{color.inkSoft}}; font-size: 11px; }
.about { color: {{color.inkSoft}}; margin: 0; max-width: 620px; }
.day-strip { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; }
.day-chip { flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1px; min-width: 52px; padding: 9px 0; border-radius: 14px; border: 1.5px solid {{color.line}}; background: {{color.surface}}; color: {{color.inkSoft}}; font-size: 12px; }
.day-chip strong { font-size: 16px; color: {{color.ink}}; }
.day-on { background: {{state.chipOn.bg}}; border-color: {{color.brand}}; color: {{state.chipOn.fg}}; }
.day-on strong { color: {{state.chipOn.fg}}; }
.slot-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
.slot { border: 1.5px solid {{color.line}}; background: {{color.surface}}; border-radius: 10px; padding: 10px 2px; font-weight: 600; font-size: 13px; }
.slot:hover:not(:disabled) { border-color: {{color.brand}}; }
.slot-on { background: {{state.chipOn.bg}}; color: {{state.chipOn.fg}}; border-color: {{color.brand}}; }
.slot-taken { color: {{color.inkSoft}}; text-decoration: line-through; background: {{color.input}}; cursor: not-allowed; }
.field { display: block; margin-bottom: 14px; }
.field > span { display: block; font-weight: 600; font-size: 13px; margin-bottom: 6px; }
.field input { width: 100%; border: 1.5px solid {{color.line}}; background: {{color.surface}}; border-radius: 12px; padding: 12px 14px; font: inherit; color: {{color.ink}}; }
.field input::placeholder { color: {{color.inkSoft}}; }
.input-bad { border-color: {{color.error}} !important; }
.error { display: block; color: {{color.error}}; font-size: 12px; margin-top: 5px; font-weight: 600; }
.form-note { color: {{color.inkSoft}}; font-size: 13px; margin: 2px 0 12px; }
.note-bad { color: {{color.error}}; font-weight: 700; }
.cta { background: {{state.cta.bg}}; color: {{state.cta.fg}}; border-radius: {{radius.pill}}px; padding: 14px 26px; font-weight: 700; font-size: 15px; width: 100%; transition: background 0.15s ease; }
.cta:hover { background: {{state.cta.hoverBg}}; }
.btn-quiet { border-radius: {{radius.pill}}px; padding: 13px 22px; font-weight: 600; color: {{color.inkSoft}}; border: 1.5px solid {{color.line}}; background: {{color.surface}}; }

/* confirmation */
.confirm-main { text-align: center; padding-top: 56px; padding-bottom: 96px; }
.confirm-mark { width: 72px; height: 72px; margin: 0 auto 16px; border-radius: 50%; background: {{color.cert}}; color: {{color.onBrand}}; font-size: 34px; display: grid; place-items: center; }
.confirm-h { font-size: 24px; margin: 0 0 6px; }
.confirm-ref { color: {{color.inkSoft}}; }
.summary { text-align: left; background: {{color.surface}}; border: 1px solid {{color.line}}; border-radius: {{radius.card}}px; padding: 8px 16px; max-width: 520px; margin: 18px auto; }
.summary > div { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px solid {{color.line}}; }
.summary > div:last-child { border-bottom: 0; }
.summary span { color: {{color.inkSoft}}; }
.confirm-actions { display: flex; flex-direction: column; gap: 10px; max-width: 520px; margin: 0 auto; }
.confirm-actions .cta { width: 100%; }

/* appointments */
.appts-main { padding-top: 16px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 12px; }
.appt { display: flex; gap: 14px; align-items: flex-start; background: {{color.surface}}; border: 1px solid {{color.line}}; border-radius: {{radius.card}}px; padding: 14px; }
.appt-main { flex: 1; display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.appt-main > span { color: {{color.inkSoft}}; font-size: 13px; }
.appt-when { color: {{color.ink}} !important; font-weight: 600; }
.btn-cancel { color: {{color.error}}; font-weight: 700; font-size: 13px; border: 1.5px solid {{color.error}}; border-radius: {{radius.pill}}px; padding: 7px 14px; flex: 0 0 auto; }
.cancel-confirm { display: flex; flex-direction: column; gap: 6px; flex: 0 0 auto; }
.btn-danger { background: {{color.error}}; color: {{color.onBrand}}; font-weight: 700; font-size: 13px; border-radius: {{radius.pill}}px; padding: 8px 14px; }
.cancel-confirm .btn-quiet { padding: 7px 14px; font-size: 13px; }
.empty { text-align: center; padding: 56px 0; }
.empty h2 { font-size: 20px; }
.empty p { color: {{color.inkSoft}}; }
.empty .cta { width: auto; margin-top: 8px; }

/* tab bar */
.tabbar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; background: {{color.surface}}; border-top: 1px solid {{color.line}}; padding: 8px 12px calc(8px + env(safe-area-inset-bottom)); z-index: 10; }
.tab { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 12px; font-weight: 600; color: {{state.tabIdle.fg}}; border-radius: 12px; padding: 6px 0; position: relative; }
.tab-on { color: {{state.tabActive.fg}}; }
.appt-count { position: absolute; top: 0; right: calc(50% - 26px); background: {{color.brand}}; color: {{color.onBrand}}; border-radius: {{radius.pill}}px; min-width: 20px; height: 20px; display: inline-grid; place-items: center; font-size: 11px; padding: 0 5px; }

@media (min-width: 900px) {
  .doctors { display: grid; grid-template-columns: 1fr 1fr; }
  .tabbar { display: none; }
  .home-main, .detail-main, .appts-main { padding-bottom: 48px; }
  .confirm-main { padding-bottom: 48px; }
}

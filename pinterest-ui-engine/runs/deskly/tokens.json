{
  "meta": {
    "run": "pinterest-ui-engine/runs/deskly",
    "direction": "committed-field",
    "family": "deskly",
    "familyConfig": "pinterest-ui-engine/engine/families/deskly.json",
    "generatedFrom": "design-spec.json + directions.json + families/deskly.json"
  },
  "color": {
    "ground": "#FAF5F0",
    "field": "#9A1B1E",
    "fieldText": "#FFFFFF",
    "surface": "#FFFFFF",
    "board": "#2A1414",
    "ink": "#241416",
    "inkSoft": "#6B5A5C",
    "brand": "#9A1B1E",
    "brandDeep": "#6E1013",
    "tint": "#F7E4E1",
    "star": "#E8A33D",
    "cert": "#1E5B3C",
    "onBrand": "#FFFFFF",
    "line": "#EBD9D4",
    "lineStrong": "#DFC6C0",
    "error": "#A02026",
    "warning": null,
    "success": "#1E5B3C",
    "input": "#F6EDE9",
    "inputText": "#241416"
  },
  "font": {
    "display": "\"Iowan Old Style\", \"Palatino Linotype\", Georgia, \"Times New Roman\", serif",
    "ui": "-apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
  },
  "type": {
    "body": 15,
    "display": 30,
    "section": 18,
    "small": 12,
    "amount": 16
  },
  "space": [
    4,
    8,
    12,
    16,
    20,
    24,
    32
  ],
  "radius": {
    "sheet": 22,
    "card": 16,
    "pill": 999,
    "addBtn": 36
  },
  "shadow": {
    "card": "0 10px 24px rgba(42, 20, 20, 0.10)",
    "sheet": "0 -12px 32px rgba(42, 20, 20, 0.12)"
  },
  "borders": {
    "hairlineWidth": "1px",
    "stepperWidth": "1.5px",
    "focusRing": {
      "width": "3px",
      "offset": "2px",
      "color": "brand"
    }
  },
  "responsive": {
    "breakpoint": 900,
    "mobile": "Single column. Committed red hero field; desk rows below. Fixed bottom tab bar (Desks / Bookings).",
    "desktop": "Two-column desk grid. Tab bar hidden; hero field keeps its full width."
  },
  "density": {
    "lineHeight": 1.45,
    "bodyScale": 1
  },
  "state": {
    "cta": {
      "bg": "#9A1B1E",
      "fg": "#FFFFFF",
      "hoverBg": "#6E1013"
    },
    "chipOn": {
      "bg": "#9A1B1E",
      "fg": "#FFFFFF"
    },
    "chipOff": {
      "bg": "#FFFFFF",
      "fg": "#241416"
    },
    "badge": {
      "bg": "#F7E4E1",
      "fg": "#6E1013"
    },
    "stepper": {
      "bg": "#FFFFFF",
      "fg": "#241416",
      "line": "#DFC6C0"
    },
    "tabActive": {
      "fg": "#9A1B1E"
    },
    "tabIdle": {
      "fg": "#6B5A5C"
    },
    "priceOnDark": {
      "fg": "#FFFFFF"
    },
    "disabled": {
      "bg": "#F1E7E4",
      "fg": "#6B5A5C"
    }

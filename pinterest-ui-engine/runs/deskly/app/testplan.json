{
  "app": "Deskly",
  "entity": "desk",
  "entryView": "desks",
  "recordCount": 6,
  "derivedFrom": "layout IR v2 (planner 2.0.0)",
  "steps": [
    {
      "id": "T1",
      "desc": "the desks list renders all 6 records",
      "act": "count",
      "sel": "[data-testid=\"desk-card\"]",
      "eq": 6
    },
    {
      "id": "T2",
      "desc": "the collection container is present",
      "act": "visible",
      "sel": "[data-testid=\"desk-list\"]",
      "eq": true
    },
    {
      "id": "T3",
      "desc": "filtering by Zone = Window shows 2",
      "act": "click",
      "sel": "[data-testid=\"zone-chip\"][data-zone=\"Window\"]"
    },
    {
      "id": "T4",
      "desc": "only 2 record(s) remain after filtering",
      "act": "count",
      "sel": "[data-testid=\"desk-card\"]",
      "eq": 2
    },
    {
      "id": "T5",
      "desc": "the filter chip reports pressed state",
      "act": "attr",
      "sel": "[data-testid=\"zone-chip\"][data-zone=\"Window\"]",
      "attr": "aria-pressed",
      "eq": "true"
    },
    {
      "id": "T6",
      "desc": "the All chip restores every record",
      "act": "click",
      "sel": "[data-testid=\"zone-chip\"][data-zone=\"All\"]"
    },
    {
      "id": "T7",
      "desc": "all records are back",
      "act": "count",
      "sel": "[data-testid=\"desk-card\"]",
      "eq": 6
    },
    {
      "id": "T8",
      "desc": "searching \"Window desk 04\" narrows to 1",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": "Window desk 04"
    },
    {
      "id": "T9",
      "desc": "search yields 1 record(s)",
      "act": "count",
      "sel": "[data-testid=\"desk-card\"]",
      "eq": 1
    },
    {
      "id": "T10",
      "desc": "clearing search restores every record",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": ""
    },
    {
      "id": "T11",
      "desc": "all records are back after clearing search",
      "act": "count",
      "sel": "[data-testid=\"desk-card\"]",
      "eq": 6
    },
    {
      "id": "T12",
      "desc": "opening the first record shows its detail",
      "act": "click",
      "sel": "[data-testid=\"desk-card\"][data-id=\"d1\"]"
    },
    {
      "id": "T13",
      "desc": "the detail heading is the record title",
      "act": "text",
      "sel": "[data-testid=\"detail-title\"]",
      "eq": "Window desk 04"
    },
    {
      "id": "T14",
      "desc": "the detail view is the active view",
      "act": "attr",
      "sel": "#main",
      "attr": "data-view",
      "eq": "detail"
    },
    {
      "id": "T15",
      "desc": "5 day chips are offered",
      "act": "count",
      "sel": "[data-testid=\"day-chip\"]",
      "eq": 5
    },
    {
      "id": "T16",
      "desc": "day 0 shows 2 taken and 4 free slots",
      "act": "slots",
      "dayTestid": "day-chip",
      "slotTestid": "slot",
      "taken": 2,
      "free": 4
    },
    {
      "id": "T17",
      "desc": "choosing 9:00 AM marks it selected",
      "act": "click",
      "sel": "[data-testid=\"slot\"][data-slot=\"9:00 AM\"]"
    },
    {
      "id": "T18",
      "desc": "the chosen slot reports the selected state",
      "act": "attr",
      "sel": "[data-testid=\"slot\"][data-slot=\"9:00 AM\"]",
      "attr": "data-state",
      "eq": "selected"
    },
    {
      "id": "T19",
      "desc": "a taken slot (11:00 AM) cannot be selected",
      "act": "click",
      "sel": "[data-testid=\"slot\"][data-slot=\"11:00 AM\"]"
    },
    {
      "id": "T20",
      "desc": "the taken slot keeps its state",
      "act": "attr",
      "sel": "[data-testid=\"slot\"][data-slot=\"11:00 AM\"]",
      "attr": "data-state",
      "eq": "taken"
    },
    {
      "id": "T21",
      "desc": "reopening a record for the commit flow",
      "act": "goto",
      "view": "desks"
    },
    {
      "id": "T22",
      "desc": "opening a record",
      "act": "click",
      "sel": "[data-testid=\"desk-card\"][data-id=\"d1\"]"
    },
    {
      "id": "T23",
      "desc": "submitting an empty form is refused",
      "act": "click",
      "sel": "[data-testid=\"reserve-btn\"]"
    },
    {
      "id": "T24",
      "desc": "the required field shows an error",
      "act": "visible",
      "sel": "[data-testid=\"error-guest\"]",
      "eq": true
    },
    {
      "id": "T25",
      "desc": "the app did not advance to confirmation",
      "act": "attr",
      "sel": "#main",
      "attr": "data-view",
      "eq": "detail"
    },
    {
      "id": "T26",
      "desc": "the optional field \"Team (optional)\" is not treated as required",
      "act": "visible",
      "sel": "[data-testid=\"error-team\"]",
      "eq": false
    },
    {
      "id": "T27",
      "desc": "submitting without a time is refused",
      "act": "visible",
      "sel": "[data-testid=\"error-time\"]",
      "eq": true
    },
    {
      "id": "T28",
      "desc": "choosing 9:00 AM",
      "act": "click",
      "sel": "[data-testid=\"slot\"][data-slot=\"9:00 AM\"]"
    },
    {
      "id": "T29",
      "desc": "filling Your name",
      "act": "type",
      "sel": "[data-testid=\"guest-name\"]",
      "value": "Test Your name"
    },
    {
      "id": "T30",
      "desc": "filling Team (optional)",
      "act": "type",
      "sel": "[data-testid=\"guest-team\"]",
      "value": "Test Team (optional)"
    },
    {
      "id": "T31",
      "desc": "filling Mobile number",
      "act": "type",
      "sel": "[data-testid=\"guest-phone\"]",
      "value": "9876543210"
    },
    {
      "id": "T32",
      "desc": "submitting a valid form reaches confirmation",
      "act": "click",
      "sel": "[data-testid=\"reserve-btn\"]"
    },
    {
      "id": "T33",
      "desc": "confirmation is shown",
      "act": "attr",
      "sel": "#main",
      "attr": "data-view",
      "eq": "confirmation"
    },
    {
      "id": "T34",
      "desc": "a reference is issued in the declared format",
      "act": "match",
      "sel": "[data-testid=\"booking-ref\"]",
      "pattern": "^DK-\\d{6}$"
    },
    {
      "id": "T35",
      "desc": "the confirmation summarises the submission",
      "act": "visible",
      "sel": "[data-testid=\"booking-summary\"]",
      "eq": true
    },
    {
      "id": "T36",
      "desc": "the submission survives a reload",
      "act": "reload"
    },
    {
      "id": "T37",
      "desc": "the app returns to a browsable state after reload",
      "act": "visible",
      "sel": "[data-testid=\"desk-list\"]",
      "eq": true
    },
    {
      "id": "T38",
      "desc": "the committed record appears in its collection",
      "act": "goto",
      "view": "bookings"
    },
    {
      "id": "T39",
      "desc": "exactly one record is listed",
      "act": "count",
      "sel": "[data-testid=\"booking-item\"]",
      "eq": 1
    },
    {
      "id": "T40",
      "desc": "the record survives a reload",
      "act": "reload"
    },
    {
      "id": "T41",
      "desc": "the record is still listed after reload",
      "act": "goto",
      "view": "bookings"
    },
    {
      "id": "T42",
      "desc": "still one record after reload",
      "act": "count",
      "sel": "[data-testid=\"booking-item\"]",
      "eq": 1
    },
    {
      "id": "T43",
      "desc": "reopening the record shows its slot taken",
      "act": "goto",
      "view": "desks"
    },
    {
      "id": "T44",
      "desc": "opening the same record",
      "act": "click",
      "sel": "[data-testid=\"desk-card\"][data-id=\"d1\"]"
    },
    {
      "id": "T45",
      "desc": "the booked slot is now taken",
      "act": "attr",
      "sel": "[data-testid=\"slot\"][data-slot=\"9:00 AM\"]",
      "attr": "data-state",
      "eq": "taken"
    },
    {
      "id": "T46",
      "desc": "cancelling requires a confirmation step",
      "act": "goto",
      "view": "bookings"
    },
    {
      "id": "T47",
      "desc": "tapping cancel asks to confirm",
      "act": "click",
      "sel": "[data-testid=\"cancel-btn\"]"
    },
    {
      "id": "T48",
      "desc": "the confirmation control appears",
      "act": "visible",
      "sel": "[data-testid=\"cancel-confirm\"]",
      "eq": true
    },
    {
      "id": "T49",
      "desc": "confirming removes the record",
      "act": "click",
      "sel": "[data-testid=\"cancel-confirm\"]"
    },
    {
      "id": "T50",
      "desc": "the collection is empty again",
      "act": "count",
      "sel": "[data-testid=\"booking-item\"]",
      "eq": 0
    },
    {
      "id": "T51",
      "desc": "the slot is released",
      "act": "goto",
      "view": "desks"
    },
    {
      "id": "T52",
      "desc": "reopening the record after cancel",
      "act": "click",
      "sel": "[data-testid=\"desk-card\"][data-id=\"d1\"]"
    },
    {
      "id": "T53",
      "desc": "the released slot is free again",
      "act": "attr",
      "sel": "[data-testid=\"slot\"][data-slot=\"9:00 AM\"]",
      "attr": "data-state",
      "eq": "free"
    },
    {
      "id": "T54",
      "desc": "no page or console errors occurred",
      "act": "console",
      "eq": 0
    }
  ]
}
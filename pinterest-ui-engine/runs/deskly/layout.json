      "id": "commit",
      "from": "detail",
      "to": "confirmation",
      "trigger": "reserve",
      "creates": "bookings",
      "preconditions": [
        "formValid",
        "availabilitySelected"
      ],
      "persists": true
    },
    {
      "id": "cancel-bookings",
      "from": "bookings",
      "trigger": "cancel",
      "deletes": "bookings",
      "requiresConfirmation": true,
      "preconditions": [

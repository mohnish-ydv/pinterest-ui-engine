{
  "app": "StayNest",
  "entity": "listing",
  "recordCount": 6,
  "derivedFrom": "layout IR v1 (planner 1.0.0)",
  "steps": [
    {
      "id": "T1",
      "desc": "the properties list renders all 6 records",
      "act": "count",
      "sel": "[data-testid=\"listing-card\"]",
      "eq": 6
    },
    {
      "id": "T2",
      "desc": "the collection container is present",
      "act": "visible",
      "sel": "[data-testid=\"listing-list\"]",
      "eq": true
    },
    {
      "id": "T3",
      "desc": "filtering by Property type = Apartment shows 3",
      "act": "click",
      "sel": "[data-testid=\"filter-type\"][data-value=\"Apartment\"]"
    },
    {
      "id": "T4",
      "desc": "only 3 record(s) remain after filtering",
      "act": "count",
      "sel": "[data-testid=\"listing-card\"]",
      "eq": 3
    },
    {
      "id": "T5",
      "desc": "the filter chip reports pressed state",
      "act": "attr",
      "sel": "[data-testid=\"filter-type\"][data-value=\"Apartment\"]",
      "attr": "aria-pressed",
      "eq": "true"
    },
    {
      "id": "T6",
      "desc": "the All chip restores every record",
      "act": "click",
      "sel": "[data-testid=\"filter-type\"][data-value=\"All\"]"
    },
    {
      "id": "T7",
      "desc": "all records are back",
      "act": "count",
      "sel": "[data-testid=\"listing-card\"]",
      "eq": 6
    },
    {
      "id": "T8",
      "desc": "searching \"Sunlit 2BHK in Indiranagar\" narrows to 1",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": "Sunlit 2BHK in Indiranagar"
    },
    {
      "id": "T9",
      "desc": "search yields 1 record(s)",
      "act": "count",
      "sel": "[data-testid=\"listing-card\"]",
      "eq": 1
    },
    {
      "id": "T10",
      "desc": "clearing search restores every record",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": ""
    },
    {
      "id": "T11",
      "desc": "all records are back after clearing search",
      "act": "count",
      "sel": "[data-testid=\"listing-card\"]",
      "eq": 6
    },
    {
      "id": "T12",
      "desc": "opening the first record shows its detail",
      "act": "click",
      "sel": "[data-testid=\"listing-card\"][data-id=\"p1\"]"
    },
    {
      "id": "T13",
      "desc": "the detail heading is the record title",
      "act": "text",
      "sel": "[data-testid=\"detail-title\"]",
      "eq": "Sunlit 2BHK in Indiranagar"
    },
    {
      "id": "T14",
      "desc": "the detail view is the active view",
      "act": "attr",
      "sel": "#main",
      "attr": "data-view",
      "eq": "detail"
    },
    {
      "id": "T15",
      "desc": "the record is not saved yet",
      "act": "attr",
      "sel": "[data-testid=\"save-toggle\"]",
      "attr": "aria-pressed",
      "eq": "false"
    },
    {
      "id": "T16",
      "desc": "tapping save marks the record saved",
      "act": "click",
      "sel": "[data-testid=\"save-toggle\"]"
    },
    {
      "id": "T17",
      "desc": "the save control reports pressed",
      "act": "attr",
      "sel": "[data-testid=\"save-toggle\"]",
      "attr": "aria-pressed",
      "eq": "true"
    },
    {
      "id": "T18",
      "desc": "the saved collection lists the record",
      "act": "goto",
      "view": "saved"
    },
    {
      "id": "T19",
      "desc": "one record is saved",
      "act": "count",
      "sel": "[data-testid=\"listing-card\"]",
      "eq": 1
    },
    {
      "id": "T20",
      "desc": "reload keeps the saved record",
      "act": "reload"
    },
    {
      "id": "T21",
      "desc": "the saved record survives a reload",
      "act": "goto",
      "view": "saved"
    },
    {
      "id": "T22",
      "desc": "still one saved record after reload",
      "act": "count",
      "sel": "[data-testid=\"listing-card\"]",
      "eq": 1
    },
    {
      "id": "T23",
      "desc": "returning to the browse view",
      "act": "goto",
      "view": "browse"
    },
    {
      "id": "T24",
      "desc": "opening a record",
      "act": "click",
      "sel": "[data-testid=\"listing-card\"][data-id=\"p1\"]"
    },
    {
      "id": "T25",
      "desc": "submitting an empty form is refused",
      "act": "click",
      "sel": "[data-testid=\"primary-action\"]"
    },
    {
      "id": "T26",
      "desc": "the required field shows an error",
      "act": "visible",
      "sel": "[data-testid=\"error-visitor\"]",
      "eq": true
    },
    {
      "id": "T27",
      "desc": "the app did not advance to confirmation",
      "act": "attr",
      "sel": "#main",
      "attr": "data-view",
      "eq": "detail"
    },
    {
      "id": "T28",
      "desc": "submitting without a choice is refused",
      "act": "visible",
      "sel": "[data-testid=\"error-slot\"]",
      "eq": true
    },
    {
      "id": "T29",
      "desc": "choosing Sat 10:00 AM",
      "act": "click",
      "sel": "[data-testid=\"option-slot\"][data-value=\"Sat 10:00 AM\"]"
    },
    {
      "id": "T30",
      "desc": "filling Your name",
      "act": "type",
      "sel": "[data-testid=\"field-visitor\"]",
      "value": "Test Your name"
    },
    {
      "id": "T31",
      "desc": "filling Phone number",
      "act": "type",
      "sel": "[data-testid=\"field-phone\"]",
      "value": "9876543210"
    },
    {
      "id": "T32",
      "desc": "submitting a valid form reaches confirmation",
      "act": "click",
      "sel": "[data-testid=\"primary-action\"]"
    },
    {
      "id": "T33",
      "desc": "confirmation is shown",
      "act": "attr",
      "sel": "#main",
      "attr": "data-view",
      "eq": "confirmation"
    },
    {
      "id": "T34",
      "desc": "a reference is issued in the declared format",
      "act": "match",
      "sel": "[data-testid=\"confirm-ref\"]",
      "pattern": "^BV-\\d{6}$"
    },
    {
      "id": "T35",
      "desc": "the confirmation summarises the submission",
      "act": "visible",
      "sel": "[data-testid=\"confirm-summary\"]",
      "eq": true
    },
    {
      "id": "T36",
      "desc": "the booking survives a reload",
      "act": "reload"
    },
    {
      "id": "T37",
      "desc": "the app returns to a browsable state after reload",
      "act": "visible",
      "sel": "[data-testid=\"listing-list\"]",
      "eq": true
    },
    {
      "id": "T38",
      "desc": "no page or console errors occurred",
      "act": "console",
      "eq": 0
    }
  ]
}
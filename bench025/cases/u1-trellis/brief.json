  "search": {
    "fields": [
      "name"
    ],
    "placeholder": "Search campaigns",
    "testid": "search"
  },
  "filters": [
    {
      "id": "channel",
      "field": "channel",
      "label": "Channel",
      "testid": "channel-chip",
      "dataAttr": "data-channel",
      "allLabel": "All"
    }
  ],
  "aggregatesTestid": "metrics",
  "aggregatesTileTestid": "kpi-tile",
  "aggregatesValueTestid": "kpi-value",
  "functionalContract": {
    "views": [
      "overview",
      "detail"
    ],
    "testids": [
      "app-header",
      "search",
      "search-btn",
      "channel-chip",
      "campaign-list",
      "campaign-row",
      "detail-title",
      "stat-strip",
      "detail-list",
      "back-btn",
      "metrics",
      "kpi-tile",
      "kpi-value",
      "table-head"

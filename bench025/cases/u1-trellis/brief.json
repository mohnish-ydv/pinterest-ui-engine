{
  "app": "Trellis \u2014 campaign analytics (untouched case U1: data-dense dashboard)",
  "brand": "Trellis",
  "tagline": "Where the money went.",
  "subtitle": "Campaign performance across paid, owned and earned.",
  "location": "Mumbai",
  "currency": "\u20b9",
  "unit": "",
  "domain": "analytics",
  "family": "trellis",
  "views": [
    "overview"
  ],
  "entity": {
    "id": "campaign",
    "label": "Campaign",
    "plural": "Campaigns",
    "media": false,
    "titleClass": "campaign-name",
    "backTestid": "back-btn",
    "collection": {
      "listTestid": "campaign-list",
      "itemTestid": "campaign-row",
      "openTestid": "campaign-open"
    },
    "fields": [
      {
        "id": "name",
        "type": "text",
        "role": "title",
        "label": "Campaign"
      },
      {
        "id": "channel",
        "type": "enum",
        "role": "subtitle",
        "label": "Channel",
        "options": [
          "Paid search",
          "Social",
          "Email",
          "Display",
          "Affiliate"
        ]
      },
      {
        "id": "spend",
        "type": "money",
        "role": "price",
        "label": "Spend"
      },
      {
        "id": "clicks",
        "type": "number",
        "role": "stat",
        "label": "Clicks"
      },
      {
        "id": "ctr",
        "type": "number",
        "role": "stat",
        "label": "CTR %"
      },
      {
        "id": "revenue",
        "type": "money",
        "role": "detail",
        "label": "Revenue"
      },
      {
        "id": "roas",
        "type": "number",
        "role": "meta",
        "label": "ROAS",
        "suffix": "x"
      },
      {
        "id": "owner",
        "type": "text",
        "role": "detail",
        "label": "Owner"
      }
    ],

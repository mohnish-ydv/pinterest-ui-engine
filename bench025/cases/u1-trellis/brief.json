      },
      {
        "field": "ctr",
        "label": "CTR",
        "align": "right"
      },
      {
        "field": "roas",
        "label": "ROAS",
        "align": "right"
      }
    ]
  },
  "ranges": [
    {
      "id": "7d",
      "label": "7 days"
    },
    {
      "id": "30d",
      "label": "30 days"
    },
    {
      "id": "90d",
      "label": "90 days"
    }
  ]

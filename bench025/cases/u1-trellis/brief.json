  },
  "aggregates": [
    {
      "id": "spend",
      "label": "Spend",
      "op": "sum",
      "field": "spend",
      "format": "money"
    },
    {
      "id": "revenue",
      "label": "Revenue",
      "op": "sum",
      "field": "revenue",
      "format": "money"
    },
    {
      "id": "ctr",
      "label": "Avg CTR",
      "op": "mean",
      "field": "ctr",

{
  "app": "Depot",
  "entity": "ticket",
  "entryView": "tickets",
  "recordCount": 5,
  "derivedFrom": "layout IR v2 (planner 2.0.0)",
  "steps": [
    {
      "id": "T1",
      "desc": "the tickets list renders all 5 records",
      "act": "count",
      "sel": "[data-testid=\"ticket-row\"]",
      "eq": 5
    },
    {
      "id": "T2",
      "desc": "the collection container is present",
      "act": "visible",
      "sel": "[data-testid=\"ticket-list\"]",
      "eq": true
    },
    {
      "id": "T3",
      "desc": "the table has 5 column headers",
      "act": "count",
      "sel": "[data-testid=\"table-head\"]",
      "eq": 5
    },
    {
      "id": "T4",
      "desc": "filtering by Priority = P1 shows 2",
      "act": "click",
      "sel": "[data-testid=\"priority-chip\"][data-priority=\"P1\"]"
    },
    {
      "id": "T5",
      "desc": "only 2 record(s) remain after filtering",
      "act": "count",
      "sel": "[data-testid=\"ticket-row\"]",
      "eq": 2
    },
    {
      "id": "T6",
      "desc": "the filter chip reports pressed state",
      "act": "attr",
      "sel": "[data-testid=\"priority-chip\"][data-priority=\"P1\"]",
      "attr": "aria-pressed",
      "eq": "true"
    },
    {
      "id": "T7",
      "desc": "the All chip restores every record",
      "act": "click",
      "sel": "[data-testid=\"priority-chip\"][data-priority=\"All\"]"
    },
    {
      "id": "T8",
      "desc": "all records are back",
      "act": "count",
      "sel": "[data-testid=\"ticket-row\"]",
      "eq": 5
    },
    {
      "id": "T9",
      "desc": "searching \"DP-4471\" narrows to 1",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": "DP-4471"
    },
    {
      "id": "T10",
      "desc": "search yields 1 record(s)",
      "act": "count",
      "sel": "[data-testid=\"ticket-row\"]",
      "eq": 1
    },
    {
      "id": "T11",
      "desc": "clearing search restores every record",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": ""
    },
    {
      "id": "T12",
      "desc": "all records are back after clearing search",
      "act": "count",
      "sel": "[data-testid=\"ticket-row\"]",
      "eq": 5
    },
    {
      "id": "T13",
      "desc": "opening the first record shows its detail",
      "act": "click",
      "sel": "[data-testid=\"ticket-row\"][data-id=\"t1\"]"
    },
    {
      "id": "T14",
      "desc": "the detail heading is the record title",
      "act": "text",
      "sel": "[data-testid=\"detail-title\"]",
      "eq": "DP-4471"
    },
    {
      "id": "T15",
      "desc": "the detail view is the active view",
      "act": "attr",
      "sel": "#main",
      "attr": "data-view",
      "eq": "detail"
    },
    {
      "id": "T16",
      "desc": "no page or console errors occurred",
      "act": "console",
      "eq": 0
    }
  ]
}
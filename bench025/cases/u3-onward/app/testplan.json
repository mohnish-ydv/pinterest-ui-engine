{
  "app": "Onward",
  "entity": "hire",
  "entryView": "hires",
  "recordCount": 5,
  "derivedFrom": "layout IR v2 (planner 2.0.0)",
  "steps": [
    {
      "id": "T1",
      "desc": "the hires list renders all 5 records",
      "act": "count",
      "sel": "[data-testid=\"hire-card\"]",
      "eq": 5
    },
    {
      "id": "T2",
      "desc": "the collection container is present",
      "act": "visible",
      "sel": "[data-testid=\"hire-list\"]",
      "eq": true
    },
    {
      "id": "T3",
      "desc": "filtering by Stage = Draft shows 1",
      "act": "click",
      "sel": "[data-testid=\"stage-chip\"][data-stage=\"Draft\"]"
    },
    {
      "id": "T4",
      "desc": "only 1 record(s) remain after filtering",
      "act": "count",
      "sel": "[data-testid=\"hire-card\"]",
      "eq": 1
    },
    {
      "id": "T5",
      "desc": "the filter chip reports pressed state",
      "act": "attr",
      "sel": "[data-testid=\"stage-chip\"][data-stage=\"Draft\"]",
      "attr": "aria-pressed",
      "eq": "true"
    },
    {
      "id": "T6",
      "desc": "the All chip restores every record",
      "act": "click",
      "sel": "[data-testid=\"stage-chip\"][data-stage=\"All\"]"
    },
    {
      "id": "T7",
      "desc": "all records are back",
      "act": "count",
      "sel": "[data-testid=\"hire-card\"]",
      "eq": 5
    },
    {
      "id": "T8",
      "desc": "searching \"Priya Raghavan\" narrows to 1",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": "Priya Raghavan"
    },
    {
      "id": "T9",
      "desc": "search yields 1 record(s)",
      "act": "count",
      "sel": "[data-testid=\"hire-card\"]",
      "eq": 1
    },
    {
      "id": "T10",
      "desc": "clearing search restores every record",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": ""
    },
    {
      "id": "T11",
      "desc": "all records are back after clearing search",
      "act": "count",
      "sel": "[data-testid=\"hire-card\"]",
      "eq": 5
    },
    {
      "id": "T12",
      "desc": "opening the first record shows its detail",
      "act": "click",
      "sel": "[data-testid=\"hire-card\"][data-id=\"h1\"]"
    },
    {
      "id": "T13",
      "desc": "the detail heading is the record title",
      "act": "text",
      "sel": "[data-testid=\"detail-title\"]",
      "eq": "Priya Raghavan"
    },
    {
      "id": "T14",
      "desc": "the detail view is the active view",
      "act": "attr",
      "sel": "#main",
      "attr": "data-view",
      "eq": "detail"
    },
    {
      "id": "T15",
      "desc": "reopening a record for the step flow",
      "act": "goto",
      "view": "hires"
    },
    {
      "id": "T16",
      "desc": "opening a record",
      "act": "click",
      "sel": "[data-testid=\"hire-card\"][data-id=\"h1\"]"
    },
    {
      "id": "T17",
      "desc": "the flow shows 3 steps",
      "act": "count",
      "sel": "[data-testid=\"step\"]",
      "eq": 3
    },
    {
      "id": "T18",
      "desc": "the first step is current",
      "act": "attr",
      "sel": "[data-testid=\"step\"][data-step=\"1\"]",
      "attr": "data-state",
      "eq": "current"
    },
    {
      "id": "T19",
      "desc": "filling Candidate name",
      "act": "type",
      "sel": "[data-testid=\"candidate-name\"]",
      "value": "Test Candidate name"
    },
    {
      "id": "T20",
      "desc": "filling Hiring manager",
      "act": "type",
      "sel": "[data-testid=\"manager-name\"]",
      "value": "Test Hiring manager"
    },
    {
      "id": "T21",
      "desc": "filling Work email",
      "act": "type",
      "sel": "[data-testid=\"candidate-email\"]",
      "value": "Test Work email"
    },
    {
      "id": "T22",
      "desc": "Continue advances the flow",
      "act": "click",
      "sel": "[data-testid=\"step-next\"]"
    },
    {
      "id": "T23",
      "desc": "the second step is current",
      "act": "attr",
      "sel": "[data-testid=\"step\"][data-step=\"2\"]",
      "attr": "data-state",
      "eq": "current"
    },
    {
      "id": "T24",
      "desc": "Back returns to the first step",
      "act": "click",
      "sel": "[data-testid=\"step-back\"]"
    },
    {
      "id": "T25",
      "desc": "the first step is current again",
      "act": "attr",
      "sel": "[data-testid=\"step\"][data-step=\"1\"]",
      "attr": "data-state",
      "eq": "current"
    },
    {
      "id": "T26",
      "desc": "Continue to step 2",
      "act": "click",
      "sel": "[data-testid=\"step-next\"]"
    },
    {
      "id": "T27",
      "desc": "Continue to step 3",
      "act": "click",
      "sel": "[data-testid=\"step-next\"]"
    },
    {
      "id": "T28",
      "desc": "the final step is current",
      "act": "attr",
      "sel": "[data-testid=\"step\"][data-step=\"3\"]",
      "attr": "data-state",
      "eq": "current"
    },
    {
      "id": "T29",
      "desc": "committing issues a reference",
      "act": "click",
      "sel": "[data-testid=\"confirm-btn\"]"
    },
    {
      "id": "T30",
      "desc": "the confirmation is shown",
      "act": "attr",
      "sel": "#main",
      "attr": "data-view",
      "eq": "confirmation"
    },
    {
      "id": "T31",
      "desc": "a reference is issued in the declared format",
      "act": "match",
      "sel": "[data-testid=\"onboard-ref\"]",
      "pattern": "^ON-\\d{6}$"
    },
    {
      "id": "T32",
      "desc": "no page or console errors occurred",
      "act": "console",
      "eq": 0
    }
  ]
}
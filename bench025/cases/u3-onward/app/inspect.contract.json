{
  "id": "hire-generated",
  "app": "app",
  "viewport": {
    "width": 390,
    "height": 844
  },
  "desktop": {
    "width": 1440,
    "height": 900
  },
  "derivedFrom": "layout IR v2 (planner 2.0.0)",
  "steps": [
    {
      "shot": "browse-390"
    },
    {
      "measure": "cardTitle",
      "kind": "rest",
      "selector": "[data-testid=\"hire-card\"] .card-title, [data-testid=\"hire-card\"] .row-title",
      "sequence": [
        "initial render"
      ]
    },
    {
      "measure": "cardSub",
      "kind": "rest",
      "selector": "[data-testid=\"hire-card\"] .card-sub, [data-testid=\"hire-card\"] .row-sub",
      "sequence": [
        "initial render"
      ]
    },
    {
      "centre": "[data-testid=\"stage-chip\"][data-stage=\"Draft\"]"
    },
    {
      "click": "[data-testid=\"stage-chip\"][data-stage=\"Draft\"]",
      "settleMs": 250
    },
    {
      "measure": "chipSelected",
      "kind": "selected",
      "selector": "[data-testid=\"stage-chip\"][data-stage=\"Draft\"]",
      "sequence": [
        "select filter"
      ]
    },
    {
      "shot": "browse-filtered-390"
    },
    {
      "click": "[data-testid=\"stage-chip\"][data-stage=\"All\"]",
      "settleMs": 250
    },
    {
      "centre": "[data-testid=\"hire-card\"][data-id=\"h1\"]"
    },
    {
      "click": "[data-testid=\"hire-card\"][data-id=\"h1\"]",
      "settleMs": 350
    },
    {
      "shot": "detail-390"
    },
    {
      "measure": "detailTitle",
      "kind": "rest",
      "selector": "[data-testid=\"detail-title\"]",
      "sequence": [
        "open first record"
      ]
    },
    {
      "measure": "ctaRest",
      "kind": "rest",
      "selector": "[data-testid=\"confirm-btn\"]",
      "sequence": [
        "detail view, pointer away"
      ]
    },
    {
      "centre": "[data-testid=\"confirm-btn\"]"
    },
    {
      "hover": "[data-testid=\"confirm-btn\"]",
      "settleMs": 300
    },
    {
      "measure": "ctaHover",
      "kind": "hover",
      "selector": "[data-testid=\"confirm-btn\"]",
      "sequence": [
        "hover the primary action"
      ]
    },
    {
      "click": "[data-testid=\"confirm-btn\"]",
      "settleMs": 350
    },
    {
      "measure": "errorText",
      "kind": "error",
      "selector": "[data-testid=\"error-candidate\"]",
      "sequence": [
        "submit an empty form"
      ]
    },
    {
      "shot": "detail-errors-390"
    },
    {
      "setValues": [
        {
          "selector": "[data-testid=\"candidate-name\"]",
          "value": "Test Candidate name"
        },
        {
          "selector": "[data-testid=\"manager-name\"]",
          "value": "Test Hiring manager"
        },
        {
          "selector": "[data-testid=\"candidate-email\"]",
          "value": "Test Work email"
        }
      ]
    },
    {
      "centre": "[data-testid=\"confirm-btn\"]"
    },
    {
      "click": "[data-testid=\"confirm-btn\"]",
      "settleMs": 450
    },
    {
      "shot": "confirmation-390"
    },
    {
      "measure": "confirmRef",
      "kind": "post-action",
      "selector": "[data-testid=\"onboard-ref\"]",
      "sequence": [
        "complete a submission"
      ]
    },
    {
      "axe": "hires"
    },
    {
      "viewport": {
        "width": 1440,
        "height": 900
      }
    },
    {
      "click": "[data-act=\"nav\"][data-view=\"hires\"], [data-act=\"go\"][data-view=\"hires\"]",
      "settleMs": 350,
      "optional": true
    },
    {
      "shot": "browse-1440"
    },
    {
      "centre": "[data-testid=\"hire-card\"][data-id=\"h1\"]"
    },
    {
      "click": "[data-testid=\"hire-card\"][data-id=\"h1\"]",
      "settleMs": 300
    },
    {
      "shot": "detail-1440"
    },
    {
      "axe": "detail"
    }
  ]
}
{
  "irVersion": 2,
  "meta": {
    "plannerVersion": "2.0.0",
    "app": "Market Row",
    "domain": "commerce",
    "family": "marketrow",
    "density": "airy",
    "densityBasis": "light share 79.9%, saturated share 5.3% — a near-white board reads airy",
    "generatedFrom": [
      "brief.json",
      "reference-profile.json"
    ]
  },
  "entity": {
    "id": "good",
    "label": "Good",
    "plural": "Goods",
    "media": true,
    "fields": [
      {
        "id": "name",
        "type": "text",
        "role": "title",
        "label": "Good"
      },
      {
        "id": "maker",
        "type": "text",
        "role": "subtitle",
        "label": "Maker"
      },
      {
        "id": "price",
        "type": "money",
        "role": "price",
        "label": "Price"
      },
      {
        "id": "rating",
        "type": "rating",
        "role": "meta",
        "label": "Rating"
      },
      {
        "id": "reviews",
        "type": "number",
        "role": "meta",
        "label": "Reviews",
        "suffix": " reviews"
      },
      {
        "id": "category",
        "type": "enum",
        "role": "facet",
        "label": "Category",
        "options": [
          "Ceramics",
          "Textiles",
          "Wood",
          "Paper"
        ]
      },
      {
        "id": "handmade",
        "type": "bool",
        "role": "badge",
        "label": "Handmade",
        "trueLabel": "Handmade"
      },
      {
        "id": "stock",
        "type": "number",
        "role": "stat",
        "label": "In stock"
      },
      {
        "id": "story",
        "type": "text",
        "role": "detail",
        "label": "Story"
      }
    ],
    "titleClass": "good-name"
  },
  "search": {
    "fields": [
      "name",
      "maker"
    ],
    "placeholder": "Search goods or makers",
    "testid": "search"
  },
  "filters": [
    {
      "id": "category",
      "field": "category",
      "label": "Category",
      "testid": "category-chip",
      "dataAttr": "data-category",
      "allLabel": "All"
    }
  ],
  "availability": null,
  "actions": [
    {
      "id": "save",
      "label": "Save",
      "kind": "toggle",
      "field": "saved"
    },
    {
      "id": "reserve",
      "label": "Reserve for pickup",
      "kind": "commit",
      "testid": "reserve-btn",
      "form": [
        {
          "id": "name",
          "label": "Your name",
          "type": "text",
          "testid": "buyer-name",
          "errorTestid": "error-name",
          "required": true,
          "minLength": 2,
          "message": "Enter your name (at least 2 characters)."
        },
        {
          "id": "phone",
          "label": "Mobile number",
          "type": "tel",
          "testid": "buyer-phone",
          "errorTestid": "error-phone",
          "required": true,
          "pattern": "^\\d{10}$",
          "stripWhitespace": true,
          "message": "Enter a 10-digit mobile number."
        }
      ],
      "options": {
        "id": "pickup",
        "label": "Pickup day",
        "values": [
          "Saturday",
          "Sunday",
          "Monday"
        ],
        "required": true
      },
      "result": {
        "collection": "reservations",
        "referencePrefix": "MR",
        "title": "Reserved",
        "referenceTestid": "reserve-ref",
        "summaryTestid": "reserve-summary"
      }
    }
  ],
  "collections": [],
  "banners": [],
  "navigation": {
    "pattern": "tabbar",
    "items": [
      {
        "id": "nav-shop",
        "label": "Shop",
        "view": "shop",
        "icon": "grid",
        "dataNav": "shop"
      },
      {
        "id": "saved-open",
        "label": "Saved",
        "view": "saved",
        "icon": "heart",
        "dataNav": "saved"
      }
    ],
    "basis": "2 top-level destinations, mobile-first"
  },
  "views": [
    {
      "id": "shop",
      "purpose": "browse",
      "title": "Made by people you could meet.",
      "sections": [
        {
          "id": "header",
          "component": "app-header",
          "props": {
            "brand": "Market Row",
            "context": "Pune",
            "testid": "app-header"
          }
        },
        {
          "id": "heading",
          "component": "page-heading",
          "props": {
            "title": "Made by people you could meet.",
            "subtitle": "Small-batch goods from makers within fifty kilometres."
          }
        },
        {
          "id": "search",
          "component": "search-bar",
          "props": {
            "placeholder": "Search goods or makers",
            "testid": "search"
          },
          "binding": {
            "entity": "good",
            "fields": [
              "name",
              "maker"
            ]
          }
        },
        {
          "id": "filter-category",
          "component": "filter-chips",
          "props": {
            "label": "Category",
            "testid": "category-chip",
            "allLabel": "All",
            "valueAttr": "data-category"
          },
          "binding": {
            "entity": "good",
            "filterId": "category",
            "field": "category",
            "options": [
              "Ceramics",
              "Textiles",
              "Wood",
              "Paper"
            ]
          }
        },
        {
          "id": "collection",
          "component": "entity-collection",
          "variant": "card",
          "props": {
            "testid": "good-list",
            "itemTestid": "good-card",
            "columns": {
              "mobile": 1,
              "desktop": 2
            },
            "showMedia": true,
            "showStatus": false,
            "showSave": true,
            "saveTestid": "save-toggle",
            "openTestid": "good-open"
          },
          "binding": {
            "entity": "good",
            "source": "records",
            "standfirstField": null
          },
          "controls": [
            "search",
            "filter:category"
          ],
          "states": [
            "populated",
            "empty"
          ]
        }
      ]
    },
    {
      "id": "saved",
      "purpose": "collection",
      "title": "Saved",
      "sections": [
        {
          "id": "header",
          "component": "app-header",
          "props": {
            "brand": "Market Row",
            "context": "Pune",
            "testid": "app-header"
          }
        },
        {
          "id": "heading",
          "component": "page-heading",
          "props": {
            "title": "Saved",
            "subtitle": "Your shortlisted goods."
          }
        },
        {
          "id": "collection",
          "component": "entity-collection",
          "variant": "card",
          "binding": {
            "entity": "good",
            "source": "saved"
          },
          "props": {
            "testid": "good-list",
            "itemTestid": "good-card",
            "columns": {
              "mobile": 1,
              "desktop": 2
            },
            "showMedia": true,
            "showStatus": false,
            "showSave": true,
            "saveTestid": "save-toggle"
          },
          "states": [
            "populated",
            "empty"
          ],
          "emptyMessage": "Nothing saved yet. Tap the heart on something you like."
        }
      ]
    },
    {
      "id": "detail",
      "purpose": "record",
      "title": "Good",
      "sections": [
        {
          "id": "header",
          "component": "app-header",
          "props": {
            "brand": "Market Row",
            "context": "Pune",
            "back": true,
            "testid": "app-header",
            "backTestid": "back-btn"
          }
        },
        {
          "id": "record",
          "component": "record-header",
          "props": {
            "showMedia": true,
            "showStatus": false,
            "showSave": true,
            "saveTestid": "save-toggle",
            "titleClass": "good-name"
          },
          "binding": {
            "entity": "good",
            "title": "name",
            "subtitle": "maker",
            "price": "price"
          }
        },
        {
          "id": "stats",
          "component": "stat-strip",
          "props": {
            "testid": "stat-strip"
          },
          "binding": {
            "entity": "good",
            "fields": [
              "stock"
            ]
          }
        },
        {
          "id": "details",
          "component": "detail-list",
          "props": {
            "testid": "detail-list"
          },
          "binding": {
            "entity": "good",
            "fields": [
              "rating",
              "reviews",
              "story"
            ]
          }
        },
        {
          "id": "options",
          "component": "option-grid",
          "props": {
            "label": "Pickup day",
            "testid": "option-pickup",
            "required": true
          },
          "binding": {
            "entity": "good",
            "field": "pickup",
            "options": [
              "Saturday",
              "Sunday",
              "Monday"
            ]
          }
        },
        {
          "id": "form",
          "component": "form-fields",
          "props": {
            "testid": "form",
            "submitLabel": "Reserve for pickup"
          },
          "binding": {
            "entity": "good",
            "fields": [
              {
                "id": "name",
                "label": "Your name",
                "type": "text",
                "testid": "buyer-name",
                "errorTestid": "error-name",
                "required": true,
                "minLength": 2,
                "message": "Enter your name (at least 2 characters)."
              },
              {
                "id": "phone",
                "label": "Mobile number",
                "type": "tel",
                "testid": "buyer-phone",
                "errorTestid": "error-phone",
                "required": true,
                "pattern": "^\\d{10}$",
                "stripWhitespace": true,
                "message": "Enter a 10-digit mobile number."
              }
            ]
          }
        },
        {
          "id": "cta",
          "component": "primary-action",
          "props": {
            "label": "Reserve for pickup",
            "testid": "reserve-btn",
            "action": "reserve",
            "showAmount": false
          },
          "binding": {
            "entity": "good",
            "amountField": "price"
          }
        }
      ],
      "hidden": true
    },
    {
      "id": "confirmation",
      "purpose": "confirmation",
      "title": "Confirmed",
      "sections": [
        {
          "id": "confirm",
          "component": "confirmation",
          "props": {
            "title": "Reserved",
            "testid": "reserve-ref",
            "summaryTestid": "reserve-summary",
            "referenceLabel": "Reference",
            "continueTo": null,
            "continueLabel": null
          },
          "binding": {
            "entity": "good",
            "referencePrefix": "MR"
          }
        }
      ],
      "hidden": true
    }
  ],
  "transitions": [
    {
      "id": "browse-to-detail",
      "from": "shop",
      "to": "detail",
      "trigger": "open",
      "preconditions": [
        "recordExists"
      ]
    },
    {
      "id": "detail-to-browse",
      "from": "detail",
      "to": "shop",
      "trigger": "back"
    },
    {
      "id": "toggle-save",
      "from": "detail",
      "trigger": "toggle",
      "collection": "saved",
      "persists": true
    },
    {
      "id": "commit",
      "from": "detail",
      "to": "confirmation",
      "trigger": "reserve",
      "creates": "reservations",
      "preconditions": [
        "formValid",
        "optionSelected"
      ],
      "persists": true
    }
  ],
  "decisions": [
    {
      "id": "density",
      "value": "airy",
      "basis": "light share 79.9%, saturated share 5.3% — a near-white board reads airy",
      "source": "reference"
    },
    {
      "id": "navigation",
      "value": "tabbar",
      "basis": "2 top-level destinations, mobile-first",
      "source": "rule"
    },
    {
      "id": "composition",
      "value": "gallery",
      "basis": "compiled from design-spec prose",
      "source": "reference"
    },
    {
      "id": "collectionVariant",
      "value": "card",
      "basis": "the entity declares media, so records lead with an image",
      "source": "brief"
    },
    {
      "id": "desktopColumns",
      "value": "2",
      "basis": "density \"airy\" sets 2 columns",
      "source": "rule"
    },
    {
      "id": "collectionSurface",
      "value": "entity-collection",
      "basis": "no table declared",
      "source": "brief"
    },
    {
      "id": "commitShape",
      "value": "form+primary-action",
      "basis": "a single-step commit is declared",
      "source": "brief"
    },
    {
      "id": "timeSelection",
      "value": "option-grid",
      "basis": "a static option list is declared",
      "source": "brief"
    },
    {
      "id": "sectionOrder",
      "value": "app-header -> page-heading -> search-bar -> filter-chips -> entity-collection",
      "basis": "entry view reads header, heading, search, facets, aggregates, collection — broad to narrow",
      "source": "rule"
    }
  ],
  "a11y": {
    "landmarks": [
      "banner",
      "main",
      "navigation"
    ],
    "headingLevels": "one h1 per view; sections use h2",
    "minTargetPx": 44,
    "keyboard": [
      "Enter activates the focused control",
      "Tab order follows reading order",
      "disabled controls are not focusable"
    ]
  }
}
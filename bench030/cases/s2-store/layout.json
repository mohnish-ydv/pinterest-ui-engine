{
  "irVersion": 2,
  "meta": {
    "plannerVersion": "2.1.0",
    "app": "Store",
    "domain": "inventory",
    "family": "store",
    "density": "compact",
    "densityBasis": "composition=table → compact: the surface is scanned for one record — density helps comparison",
    "referenceDensity": "airy",
    "generatedFrom": [
      "brief.json",
      "reference-profile.json"
    ]
  },
  "entity": {
    "id": "item",
    "label": "Item",
    "plural": "Items",
    "media": false,
    "fields": [
      {
        "id": "item",
        "label": "Item",
        "type": "text",
        "role": "title",
        "roleSource": "derived",
        "requiredIn": "entry",
        "scopeSource": "Each row shows the item, the quantity with its unit, and whether to reorder."
      },
      {
        "id": "category",
        "label": "Category",
        "type": "enum",
        "role": "facet",
        "roleSource": "derived",
        "options": [
          "Dry",
          "Oil",
          "Dairy"
        ],
        "requiredIn": "either",
        "scopeSource": "Filter by category and search by item."
      },
      {
        "id": "qty",
        "label": "Quantity",
        "type": "number",
        "role": "stat",
        "roleSource": "derived+unit-bound",
        "unitField": "unit",
        "requiredIn": "entry",
        "scopeSource": "Each row shows the item, the quantity with its unit, and whether to reorder."
      },
      {
        "id": "unit",
        "label": "Unit",
        "type": "text",
        "role": "subtitle",
        "roleSource": "derived",
        "requiredIn": "entry",
        "scopeSource": "Each row shows the item, the quantity with its unit, and whether to reorder."
      },
      {
        "id": "reorder",
        "label": "Reorder",
        "type": "enum",
        "role": "facet",
        "roleSource": "derived",
        "options": [
          "No",
          "Yes"
        ],
        "requiredIn": "entry",
        "scopeSource": "Each row shows the item, the quantity with its unit, and whether to reorder."
      }
    ],
    "titleClass": "item-name"
  },
  "search": {
    "fields": [
      "item",
      "unit"
    ],
    "placeholder": "Search items",
    "testid": "search"
  },
  "filters": [
    {
      "id": "category",
      "field": "category",
      "label": "Category",
      "testid": "category-chip",
      "dataAttr": "data-category",
      "allLabel": "All"
    },
    {
      "id": "reorder",
      "field": "reorder",
      "label": "Reorder",
      "testid": "reorder-chip",
      "dataAttr": "data-reorder",
      "allLabel": "All"
    }
  ],
  "availability": null,
  "actions": [],
  "collections": [],
  "banners": [],
  "navigation": {
    "pattern": "header-only",
    "items": [],
    "basis": "one top-level destination — no tab bar needed"
  },
  "views": [
    {
      "id": "items",
      "purpose": "browse",
      "title": "Stock on the shelf.",
      "sections": [
        {
          "id": "header",
          "component": "app-header",
          "props": {
            "brand": "Store",
            "context": "Pune",
            "testid": "app-header"
          }
        },
        {
          "id": "heading",
          "component": "page-heading",
          "props": {
            "title": "Stock on the shelf.",
            "subtitle": "What is in the dry store and how much."
          }
        },
        {
          "id": "search",
          "component": "search-bar",
          "props": {
            "placeholder": "Search items",
            "testid": "search"
          },
          "binding": {
            "entity": "item",
            "fields": [
              "item",
              "unit"
            ]
          }
        },
        {
          "id": "filter-category",
          "component": "filter-chips",
          "props": {
            "label": "Category",
            "testid": "category-chip",
            "allLabel": "All",
            "valueAttr": "data-category"
          },
          "binding": {
            "entity": "item",
            "filterId": "category",
            "field": "category",
            "options": [
              "Dry",
              "Oil",
              "Dairy"
            ]
          }
        },
        {
          "id": "filter-reorder",
          "component": "filter-chips",
          "props": {
            "label": "Reorder",
            "testid": "reorder-chip",
            "allLabel": "All",
            "valueAttr": "data-reorder"
          },
          "binding": {
            "entity": "item",
            "filterId": "reorder",
            "field": "reorder",
            "options": [
              "No",
              "Yes"
            ]
          }
        },
        {
          "id": "collection",
          "component": "entity-collection",
          "variant": "row",
          "props": {
            "testid": "item-list",
            "itemTestid": "item-card",
            "columns": {
              "mobile": 1,
              "desktop": 3
            },
            "showMedia": false,
            "showChip": false,
            "entryExtra": [],
            "forbiddenRoles": [],
            "showStatus": false,
            "showSave": false,
            "saveTestid": "save-toggle",
            "openTestid": "item-open"
          },
          "binding": {
            "entity": "item",
            "source": "records",
            "standfirstField": null
          },
          "controls": [
            "search",
            "filter:category",
            "filter:reorder"
          ],
          "states": [
            "populated",
            "empty"
          ]
        }
      ]
    },
    {
      "id": "detail",
      "purpose": "record",
      "title": "Item",
      "sections": [
        {
          "id": "header",
          "component": "app-header",
          "props": {
            "brand": "Store",
            "context": "Pune",
            "back": true,
            "testid": "app-header",
            "backTestid": "back-btn"
          }
        },
        {
          "id": "record",
          "component": "record-header",
          "props": {
            "showMedia": false,
            "showChip": false,
            "showStatus": false,
            "showSave": false,
            "saveTestid": "save-toggle",
            "titleClass": "item-name"
          },
          "binding": {
            "entity": "item",
            "title": "item",
            "subtitle": "unit"
          }
        },
        {
          "id": "stats",
          "component": "stat-strip",
          "props": {
            "testid": "stat-strip"
          },
          "binding": {
            "entity": "item",
            "fields": [
              "qty"
            ]
          }
        }
      ],
      "hidden": true
    }
  ],
  "transitions": [
    {
      "id": "browse-to-detail",
      "from": "items",
      "to": "detail",
      "trigger": "open",
      "preconditions": [
        "recordExists"
      ]
    },
    {
      "id": "detail-to-browse",
      "from": "detail",
      "to": "items",
      "trigger": "back"
    }
  ],
  "decisions": [
    {
      "id": "density",
      "value": "airy",
      "basis": "light share 76.4%, saturated share 0.55% — a near-white board reads airy",
      "source": "reference"
    },
    {
      "id": "navigation",
      "value": "header-only",
      "basis": "one top-level destination — no tab bar needed",
      "source": "rule"
    },
    {
      "id": "composition",
      "value": "table",
      "basis": "declared in design-spec.intent",
      "source": "brief"
    },
    {
      "id": "collectionVariant",
      "value": "row",
      "basis": "no media role, so records are text-led",
      "source": "brief"
    },
    {
      "id": "desktopColumns",
      "value": "3",
      "basis": "density \"airy\" sets 3 columns",
      "source": "rule"
    },
    {
      "id": "collectionSurface",
      "value": "entity-collection",
      "basis": "no table declared",
      "source": "brief"
    },
    {
      "id": "sectionOrder",
      "value": "app-header -> page-heading -> search-bar -> filter-chips -> filter-chips -> entity-collection",
      "basis": "entry view reads header, heading, search, facets, aggregates, collection — broad to narrow",
      "source": "rule"
    }
  ],
  "a11y": {
    "landmarks": [
      "banner",
      "main",
      "navigation"
    ],
    "headingLevels": "one h1 per view; sections use h2",
    "minTargetPx": 44,
    "keyboard": [
      "Enter activates the focused control",
      "Tab order follows reading order",
      "disabled controls are not focusable"
    ]
  }
}
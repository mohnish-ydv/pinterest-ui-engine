{
  "id": "category-generated",
  "app": "app",
  "viewport": {
    "width": 390,
    "height": 844
  },
  "desktop": {
    "width": 1440,
    "height": 900
  },
  "derivedFrom": "layout IR v2 (planner 2.1.0)",
  "steps": [
    {
      "shot": "browse-390"
    },
    {
      "measure": "cardTitle",
      "kind": "rest",
      "selector": "[data-testid=\"category-card\"] .card-title, [data-testid=\"category-card\"] .row-title",
      "sequence": [
        "initial render"
      ]
    },
    {
      "measure": "cardSub",
      "kind": "rest",
      "selector": "[data-testid=\"category-card\"] .card-sub, [data-testid=\"category-card\"] .row-sub",
      "sequence": [
        "initial render"
      ]
    },
    {
      "centre": "[data-testid=\"category-card\"][data-id=\"c1\"]"
    },
    {
      "click": "[data-testid=\"category-card\"][data-id=\"c1\"]",
      "settleMs": 350
    },
    {
      "shot": "detail-390"
    },
    {
      "measure": "detailTitle",
      "kind": "rest",
      "selector": "[data-testid=\"detail-title\"]",
      "sequence": [
        "open first record"
      ]
    },
    {
      "measure": "ctaRest",
      "kind": "rest",
      "selector": "[data-testid=\"confirm-btn\"]",
      "sequence": [
        "detail view, pointer away"
      ]
    },
    {
      "centre": "[data-testid=\"confirm-btn\"]"
    },
    {
      "hover": "[data-testid=\"confirm-btn\"]",
      "settleMs": 300
    },
    {
      "measure": "ctaHover",
      "kind": "hover",
      "selector": "[data-testid=\"confirm-btn\"]",
      "sequence": [
        "hover the primary action"
      ]
    },
    {
      "click": "[data-testid=\"confirm-btn\"]",
      "settleMs": 350
    },
    {
      "measure": "errorText",
      "kind": "error",
      "selector": "[data-testid=\"error-name\"]",
      "sequence": [
        "submit an empty form"
      ]
    },
    {
      "shot": "detail-errors-390"
    },
    {
      "setValues": [
        {
          "selector": "[data-testid=\"field-name\"]",
          "value": "Test Your name"
        },
        {
          "selector": "[data-testid=\"field-phone\"]",
          "value": "9876543210"
        },
        {
          "selector": "[data-testid=\"field-email\"]",
          "value": "Test Email"
        }
      ]
    },
    {
      "centre": "[data-testid=\"confirm-btn\"]"
    },
    {
      "click": "[data-testid=\"confirm-btn\"]",
      "settleMs": 450
    },
    {
      "shot": "confirmation-390"
    },
    {
      "measure": "confirmRef",
      "kind": "post-action",
      "selector": "[data-testid=\"confirm-ref\"]",
      "sequence": [
        "complete a submission"
      ]
    },
    {
      "axe": "categories"
    },
    {
      "viewport": {
        "width": 1440,
        "height": 900
      }
    },
    {
      "click": "[data-act=\"nav\"][data-view=\"categories\"], [data-act=\"go\"][data-view=\"categories\"]",
      "settleMs": 350,
      "optional": true
    },
    {
      "shot": "browse-1440"
    },
    {
      "centre": "[data-testid=\"category-card\"][data-id=\"c1\"]"
    },
    {
      "click": "[data-testid=\"category-card\"][data-id=\"c1\"]",
      "settleMs": 300
    },
    {
      "shot": "detail-1440"
    },
    {
      "axe": "detail"
    }
  ]
}
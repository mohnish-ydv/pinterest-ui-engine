{
  "app": "Shelf",
  "entity": "note",
  "entryView": "notes",
  "recordCount": 5,
  "derivedFrom": "layout IR v2 (planner 2.1.0)",
  "steps": [
    {
      "id": "T1",
      "desc": "the notes list renders all 5 records",
      "act": "count",
      "sel": "[data-testid=\"note-card\"]",
      "eq": 5
    },
    {
      "id": "T2",
      "desc": "the collection container is present",
      "act": "visible",
      "sel": "[data-testid=\"note-list\"]",
      "eq": true
    },
    {
      "id": "T3",
      "desc": "filtering by Topic = Architecture shows 2",
      "act": "click",
      "sel": "[data-testid=\"topic-chip\"][data-topic=\"Architecture\"]"
    },
    {
      "id": "T4",
      "desc": "only 2 record(s) remain after filtering",
      "act": "count",
      "sel": "[data-testid=\"note-card\"]",
      "eq": 2
    },
    {
      "id": "T5",
      "desc": "the filter chip reports pressed state",
      "act": "attr",
      "sel": "[data-testid=\"topic-chip\"][data-topic=\"Architecture\"]",
      "attr": "aria-pressed",
      "eq": "true"
    },
    {
      "id": "T6",
      "desc": "the All chip restores every record",
      "act": "click",
      "sel": "[data-testid=\"topic-chip\"][data-topic=\"All\"]"
    },
    {
      "id": "T7",
      "desc": "all records are back",
      "act": "count",
      "sel": "[data-testid=\"note-card\"]",
      "eq": 5
    },
    {
      "id": "T8",
      "desc": "searching \"Why we stopped using a queue\" narrows to 1",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": "Why we stopped using a queue"
    },
    {
      "id": "T9",
      "desc": "search yields 1 record(s)",
      "act": "count",
      "sel": "[data-testid=\"note-card\"]",
      "eq": 1
    },
    {
      "id": "T10",
      "desc": "clearing search restores every record",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": ""
    },
    {
      "id": "T11",
      "desc": "all records are back after clearing search",
      "act": "count",
      "sel": "[data-testid=\"note-card\"]",
      "eq": 5
    },
    {
      "id": "T12",
      "desc": "opening the first record shows its detail",
      "act": "click",
      "sel": "[data-testid=\"note-card\"][data-id=\"s1\"]"
    },
    {
      "id": "T13",
      "desc": "the detail heading is the record title",
      "act": "text",
      "sel": "[data-testid=\"detail-title\"]",
      "eq": "Why we stopped using a queue"
    },
    {
      "id": "T14",
      "desc": "the detail view is the active view",
      "act": "attr",
      "sel": "#main",
      "attr": "data-view",
      "eq": "detail"
    },
    {
      "id": "T15",
      "desc": "opening a record shows an article body",
      "act": "visible",
      "sel": "[data-testid=\"article-body\"]",
      "eq": true
    },
    {
      "id": "T16",
      "desc": "the article sets a measured column",
      "act": "measure",
      "sel": "[data-testid=\"article-body\"]",
      "min": 45,
      "max": 80
    },
    {
      "id": "T17",
      "desc": "the standfirst is set larger than the body",
      "act": "fontGreater",
      "a": "[data-testid=\"standfirst\"]",
      "b": "[data-testid=\"article-body\"]"
    },
    {
      "id": "T18",
      "desc": "no page or console errors occurred",
      "act": "console",
      "eq": 0
    }
  ]
}
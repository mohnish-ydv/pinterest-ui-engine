{
  "$schema": "design-family/1",
  "family": "generic",
  "description": "Generic family: the reference cannot supply a typeface, so the system stack is used.",
  "typography": {
    "displayStrategy": "sans",
    "displayStack": null,
    "uiStack": "-apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "displayRoleNote": "role only"
  },
  "borders": {
    "hairline": "#E6E4E0",
    "stepperHairline": "#E6E4E0",
    "hairlineWidth": "1px",
    "stepperWidth": "1.5px",
    "focusRing": {
      "width": "3px",
      "offset": "2px",
      "color": "brand"
    }
  },
  "shadows": {
    "card": "0 6px 18px rgba(20,20,20,0.07)",
    "sheet": "0 -12px 32px rgba(20,20,20,0.10)"
  },
  "surfaces": {
    "groundSource": "spec",
    "inputBg": "#F4F2EE",
    "inputTextSource": "ink"
  },
  "semantic": {
    "error": "spec",
    "warning": null,
    "success": "palette:cert"
  },
  "states": {
    "hoverTarget": "brandDeep",
    "disabled": {
      "bg": "#EFEDE9",
      "fg": "#6B6B6B"
    }
  },
  "density": {
    "lineHeight": 1.5,
    "bodyScale": 1
  },
  "space": [
    4,
    8,
    12,
    16,
    20,
    24,
    32
  ],
  "responsive": {
    "breakpoint": 900,
    "mobile": "single column",
    "desktop": "multi-column, tab bar hidden"
  }
}

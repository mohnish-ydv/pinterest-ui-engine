{
  "app": "Kiln",
  "entity": "piece",
  "entryView": "pieces",
  "recordCount": 6,
  "derivedFrom": "layout IR v2 (planner 2.1.0)",
  "steps": [
    {
      "id": "T1",
      "desc": "the pieces list renders all 6 records",
      "act": "count",
      "sel": "[data-testid=\"piece-card\"]",
      "eq": 6
    },
    {
      "id": "T2",
      "desc": "the collection container is present",
      "act": "visible",
      "sel": "[data-testid=\"piece-list\"]",
      "eq": true
    },
    {
      "id": "T3",
      "desc": "filtering by Glaze = Ash shows 2",
      "act": "click",
      "sel": "[data-testid=\"glaze-chip\"][data-glaze=\"Ash\"]"
    },
    {
      "id": "T4",
      "desc": "only 2 record(s) remain after filtering",
      "act": "count",
      "sel": "[data-testid=\"piece-card\"]",
      "eq": 2
    },
    {
      "id": "T5",
      "desc": "the filter chip reports pressed state",
      "act": "attr",
      "sel": "[data-testid=\"glaze-chip\"][data-glaze=\"Ash\"]",
      "attr": "aria-pressed",
      "eq": "true"
    },
    {
      "id": "T6",
      "desc": "the All chip restores every record",
      "act": "click",
      "sel": "[data-testid=\"glaze-chip\"][data-glaze=\"All\"]"
    },
    {
      "id": "T7",
      "desc": "all records are back",
      "act": "count",
      "sel": "[data-testid=\"piece-card\"]",
      "eq": 6
    },
    {
      "id": "T8",
      "desc": "searching \"Serving bowl\" narrows to 1",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": "Serving bowl"
    },
    {
      "id": "T9",
      "desc": "search yields 1 record(s)",
      "act": "count",
      "sel": "[data-testid=\"piece-card\"]",
      "eq": 1
    },
    {
      "id": "T10",
      "desc": "clearing search restores every record",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": ""
    },
    {
      "id": "T11",
      "desc": "all records are back after clearing search",
      "act": "count",
      "sel": "[data-testid=\"piece-card\"]",
      "eq": 6
    },
    {
      "id": "T12",
      "desc": "opening the first record shows its detail",
      "act": "click",
      "sel": "[data-testid=\"piece-card\"][data-id=\"k1\"]"
    },
    {
      "id": "T13",
      "desc": "the detail heading is the record title",
      "act": "text",
      "sel": "[data-testid=\"detail-title\"]",
      "eq": "Serving bowl"
    },
    {
      "id": "T14",
      "desc": "the detail view is the active view",
      "act": "attr",
      "sel": "#main",
      "attr": "data-view",
      "eq": "detail"
    },
    {
      "id": "T15",
      "desc": "no page or console errors occurred",
      "act": "console",
      "eq": 0
    }
  ]
}
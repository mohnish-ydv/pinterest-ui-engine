          "binding": {
            "entity": "piece",
            "source": "records",
            "standfirstField": null
          },
          "controls": [
            "search",
            "filter:glaze"
          ],
          "states": [
            "populated",
            "empty"
          ]
        }
      ]
    },
    {
      "id": "detail",
      "purpose": "record",
      "title": "Piece",
      "sections": [
        {
          "id": "header",
          "component": "app-header",
          "props": {
            "brand": "Kiln",
            "context": "Pune",
            "back": true,
            "testid": "app-header",
            "backTestid": "back-btn"
          }
        },
        {
          "id": "record",
          "component": "record-header",
          "props": {
            "showMedia": true,
            "showChip": true,
            "showStatus": false,
            "showSave": false,
            "saveTestid": "save-toggle",
            "titleClass": "piece-name"
          },
          "binding": {
            "entity": "piece",
            "title": "piece",
            "subtitle": "studio",
            "price": "price"
          }
        },
        {
          "id": "details",
          "component": "detail-list",
          "props": {
            "testid": "detail-list"
          },
          "binding": {
            "entity": "piece",
            "fields": [
              "note"
            ]
          }
        }
      ],
      "hidden": true
    }
  ],
  "transitions": [
    {
      "id": "browse-to-detail",
      "from": "pieces",
      "to": "detail",
      "trigger": "open",
      "preconditions": [
        "recordExists"
      ]
    },
    {
      "id": "detail-to-browse",
      "from": "detail",
      "to": "pieces",
      "trigger": "back"
    }
  ],
  "decisions": [
    {
      "id": "density",
      "value": "airy",
      "basis": "light share 79.9%, saturated share 5.3% — a near-white board reads airy",
      "source": "reference"
    },
    {
      "id": "navigation",
      "value": "header-only",
      "basis": "one top-level destination — no tab bar needed",
      "source": "rule"
    },
    {
      "id": "composition",
      "value": "gallery",
      "basis": "declared in design-spec.intent",
      "source": "brief"
    },
    {
      "id": "collectionVariant",
      "value": "card",
      "basis": "the entity declares media, so records lead with an image",
      "source": "brief"
    },
    {
      "id": "desktopColumns",
      "value": "2",
      "basis": "density \"airy\" sets 2 columns",
      "source": "rule"
    },
    {
      "id": "collectionSurface",
      "value": "entity-collection",
      "basis": "no table declared",
      "source": "brief"
    },
    {
      "id": "sectionOrder",
      "value": "app-header -> page-heading -> search-bar -> filter-chips -> entity-collection",
      "basis": "entry view reads header, heading, search, facets, aggregates, collection — broad to narrow",
      "source": "rule"
    }
  ],
  "a11y": {
    "landmarks": [
      "banner",
      "main",
      "navigation"
    ],
    "headingLevels": "one h1 per view; sections use h2",
    "minTargetPx": 44,
    "keyboard": [
      "Enter activates the focused control",
      "Tab order follows reading order",
      "disabled controls are not focusable"
    ]
  }

      "id": "pieces",
      "purpose": "browse",
      "title": "Pots, by the maker.",
      "sections": [
        {
          "id": "header",
          "component": "app-header",
          "props": {
            "brand": "Kiln",
            "context": "Pune",
            "testid": "app-header"
          }
        },
        {
          "id": "heading",
          "component": "page-heading",
          "props": {
            "title": "Pots, by the maker.",
            "subtitle": "Small-batch ceramics from four studios."
          }
        },
        {
          "id": "search",
          "component": "search-bar",
          "props": {
            "placeholder": "Search pieces",
            "testid": "search"
          },
          "binding": {
            "entity": "piece",
            "fields": [
              "piece",
              "studio"
            ]
          }
        },
        {
          "id": "filter-glaze",
          "component": "filter-chips",
          "props": {
            "label": "Glaze",
            "testid": "glaze-chip",
            "allLabel": "All",
            "valueAttr": "data-glaze"
          },
          "binding": {
            "entity": "piece",
            "filterId": "glaze",
            "field": "glaze",
            "options": [
              "Ash",
              "Celadon",
              "Tenmoku"
            ]
          }
        },
        {
          "id": "collection",
          "component": "entity-collection",
          "variant": "card",
          "props": {
            "testid": "piece-list",
            "itemTestid": "piece-card",
            "columns": {
              "mobile": 1,
              "desktop": 2
            },
            "showMedia": true,
            "showChip": true,
            "entryExtra": [],
            "forbiddenRoles": [],

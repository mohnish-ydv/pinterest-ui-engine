{
  "app": "Lane",
  "entity": "slot",
  "entryView": "slots",
  "recordCount": 6,
  "derivedFrom": "layout IR v2 (planner 2.0.0)",
  "steps": [
    {
      "id": "T1",
      "desc": "the slots list renders all 6 records",
      "act": "count",
      "sel": "[data-testid=\"slot-card\"]",
      "eq": 6
    },
    {
      "id": "T2",
      "desc": "the collection container is present",
      "act": "visible",
      "sel": "[data-testid=\"slot-list\"]",
      "eq": true
    },
    {
      "id": "T3",
      "desc": "filtering by Area = North shows 2",
      "act": "click",
      "sel": "[data-testid=\"area-chip\"][data-area=\"North\"]"
    },
    {
      "id": "T4",
      "desc": "only 2 record(s) remain after filtering",
      "act": "count",
      "sel": "[data-testid=\"slot-card\"]",
      "eq": 2
    },
    {
      "id": "T5",
      "desc": "the filter chip reports pressed state",
      "act": "attr",
      "sel": "[data-testid=\"area-chip\"][data-area=\"North\"]",
      "attr": "aria-pressed",
      "eq": "true"
    },
    {
      "id": "T6",
      "desc": "the All chip restores every record",
      "act": "click",
      "sel": "[data-testid=\"area-chip\"][data-area=\"All\"]"
    },
    {
      "id": "T7",
      "desc": "all records are back",
      "act": "count",
      "sel": "[data-testid=\"slot-card\"]",
      "eq": 6
    },
    {
      "id": "T8",
      "desc": "searching \"Mon 09:00–11:00\" narrows to 1",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": "Mon 09:00–11:00"
    },
    {
      "id": "T9",
      "desc": "search yields 1 record(s)",
      "act": "count",
      "sel": "[data-testid=\"slot-card\"]",
      "eq": 1
    },
    {
      "id": "T10",
      "desc": "clearing search restores every record",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": ""
    },
    {
      "id": "T11",
      "desc": "all records are back after clearing search",
      "act": "count",
      "sel": "[data-testid=\"slot-card\"]",
      "eq": 6
    },
    {
      "id": "T12",
      "desc": "opening the first record shows its detail",
      "act": "click",
      "sel": "[data-testid=\"slot-card\"][data-id=\"l1\"]"
    },
    {
      "id": "T13",
      "desc": "the detail heading is the record title",
      "act": "text",
      "sel": "[data-testid=\"detail-title\"]",
      "eq": "Mon 09:00–11:00"
    },
    {
      "id": "T14",
      "desc": "the detail view is the active view",
      "act": "attr",
      "sel": "#main",
      "attr": "data-view",
      "eq": "detail"
    },
    {
      "id": "T15",
      "desc": "no page or console errors occurred",
      "act": "console",
      "eq": 0
    }
  ]
}
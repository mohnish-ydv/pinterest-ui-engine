          "Paid",
          "Social",
          "Email",
          "Organic"
        ]
      },
      {
        "id": "sessions",
        "type": "number",
        "role": "stat",
        "label": "Sessions"
      },
      {
        "id": "conversion",
        "type": "number",
        "role": "stat",
        "label": "Conversion %"
      },
      {
        "id": "revenue",
        "type": "money",
        "role": "price",
        "label": "Revenue"
      },
      {
        "id": "change",
        "type": "number",
        "role": "meta",
        "label": "Change",
        "suffix": "% WoW"
      },
      {
        "id": "owner",
        "type": "text",
        "role": "detail",
        "label": "Owner"
      }

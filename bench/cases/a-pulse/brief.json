{
  "app": "Pulse \u2014 marketing analytics (benchmark case A: dashboard)",
  "brand": "Pulse",
  "tagline": "Where the traffic came from.",
  "subtitle": "Channel performance for the last 30 days.",
  "location": "Bengaluru",

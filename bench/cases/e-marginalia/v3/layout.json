{
  "irVersion": 2,
  "meta": {
    "plannerVersion": "2.0.0",
    "app": "Marginalia",
    "domain": "editorial",
    "family": "marginalia",
    "density": "comfortable",
    "densityBasis": "light share 62.8%, saturated share 19.75%",
    "generatedFrom": [
      "brief.json",
      "reference-profile.json"
    ]
  },
  "entity": {
    "id": "essay",
    "label": "Essay",
    "plural": "Essays",
    "media": false,
    "fields": [
      {
        "id": "title",
        "type": "text",
        "role": "title",
        "label": "Title"
      },
      {
        "id": "author",
        "type": "text",
        "role": "subtitle",
        "label": "Author"
      },
      {
        "id": "readTime",
        "type": "number",
        "role": "meta",
        "label": "Reading time",
        "suffix": " min read"
      },
      {
        "id": "topic",
        "type": "enum",
        "role": "facet",
        "label": "Topic",
        "options": [
          "Cities",
          "Work",
          "Memory",
          "Water"
        ]
      },
      {
        "id": "standfirst",
        "type": "text",
        "role": "detail",
        "label": "Standfirst"
      },
      {
        "id": "published",
        "type": "text",
        "role": "meta",
        "label": "Published"
      },
      {
        "id": "body",
        "type": "text",
        "role": "body",
        "label": "Body"
      }
    ],
    "titleClass": "essay-title"
  },
  "search": {
    "fields": [
      "title",
      "author"
    ],
    "placeholder": "Search essays",
    "testid": "search"
  },
  "filters": [
    {
      "id": "topic",
      "field": "topic",
      "label": "Topic",
      "testid": "topic-chip",
      "dataAttr": "data-topic",
      "allLabel": "All"
    }
  ],
  "availability": null,
  "actions": [],
  "collections": [],
  "banners": [],
  "navigation": {
    "pattern": "header-only",
    "items": [],
    "basis": "one top-level destination — no tab bar needed"
  },
  "views": [
    {
      "id": "essays",
      "purpose": "browse",
      "title": "Long reads, kept short of noise.",
      "sections": [
        {
          "id": "header",
          "component": "app-header",
          "props": {
            "brand": "Marginalia",
            "context": "Bengaluru",
            "testid": "app-header"
          }
        },
        {
          "id": "heading",
          "component": "page-heading",
          "props": {
            "title": "Long reads, kept short of noise.",
            "subtitle": "One essay a week on cities and the people in them."
          }
        },
        {
          "id": "search",
          "component": "search-bar",
          "props": {
            "placeholder": "Search essays",
            "testid": "search"
          },
          "binding": {
            "entity": "essay",
            "fields": [
              "title",
              "author"
            ]
          }
        },
        {
          "id": "filter-topic",
          "component": "filter-chips",
          "props": {
            "label": "Topic",
            "testid": "topic-chip",
            "allLabel": "All",
            "valueAttr": "data-topic"
          },
          "binding": {
            "entity": "essay",
            "filterId": "topic",
            "field": "topic",
            "options": [
              "Cities",
              "Work",
              "Memory",
              "Water"
            ]
          }
        },
        {
          "id": "collection",
          "component": "entity-collection",
          "variant": "row",
          "props": {
            "testid": "essay-list",
            "itemTestid": "essay-card",
            "columns": {
              "mobile": 1,
              "desktop": 2
            },
            "showMedia": false,
            "showStatus": false,
            "showSave": false,
            "saveTestid": "save-toggle",
            "openTestid": "essay-open"
          },
          "binding": {
            "entity": "essay",
            "source": "records"
          },
          "controls": [
            "search",
            "filter:topic"
          ],
          "states": [
            "populated",
            "empty"
          ]
        }
      ]
    },
    {
      "id": "detail",
      "purpose": "record",
      "title": "Essay",
      "sections": [
        {
          "id": "header",
          "component": "app-header",
          "props": {
            "brand": "Marginalia",
            "context": "Bengaluru",
            "back": true,
            "testid": "app-header",
            "backTestid": "back-btn"
          }
        },
        {
          "id": "record",
          "component": "record-header",
          "props": {
            "showMedia": false,
            "showStatus": false,
            "showSave": false,
            "saveTestid": "save-toggle",
            "titleClass": "essay-title"
          },
          "binding": {
            "entity": "essay",
            "title": "title",
            "subtitle": "author"
          }
        },
        {
          "id": "article",
          "component": "article",
          "props": {
            "testid": "article"
          },
          "binding": {
            "entity": "essay",
            "article": {
              "body": "body",
              "standfirst": "standfirst",
              "byline": "author"
            }
          },
          "states": [
            "populated"
          ]
        }
      ],
      "hidden": true
    }
  ],
  "transitions": [
    {
      "id": "browse-to-detail",
      "from": "essays",
      "to": "detail",
      "trigger": "open",
      "preconditions": [
        "recordExists"
      ]
    },
    {
      "id": "detail-to-browse",
      "from": "detail",
      "to": "essays",
      "trigger": "back"
    }
  ],
  "a11y": {
    "landmarks": [
      "banner",
      "main",
      "navigation"
    ],
    "headingLevels": "one h1 per view; sections use h2",
    "minTargetPx": 44,
    "keyboard": [
      "Enter activates the focused control",
      "Tab order follows reading order",
      "disabled controls are not focusable"
    ]
  }
}
{
  "id": "produce-generated",
  "app": "app",
  "viewport": {
    "width": 390,
    "height": 844
  },
  "desktop": {
    "width": 1440,
    "height": 900
  },
  "derivedFrom": "layout IR v2 (planner 2.0.0)",
  "steps": [
    {
      "shot": "browse-390"
    },
    {
      "measure": "cardTitle",
      "kind": "rest",
      "selector": "[data-testid=\"produce-card\"] .card-title, [data-testid=\"produce-card\"] .row-title",
      "sequence": [
        "initial render"
      ]
    },
    {
      "measure": "cardSub",
      "kind": "rest",
      "selector": "[data-testid=\"produce-card\"] .card-sub, [data-testid=\"produce-card\"] .row-sub",
      "sequence": [
        "initial render"
      ]
    },
    {
      "centre": "[data-testid=\"category-chip\"][data-category=\"Vegetables\"]"
    },
    {
      "click": "[data-testid=\"category-chip\"][data-category=\"Vegetables\"]",
      "settleMs": 250
    },
    {
      "measure": "chipSelected",
      "kind": "selected",
      "selector": "[data-testid=\"category-chip\"][data-category=\"Vegetables\"]",
      "sequence": [
        "select filter"
      ]
    },
    {
      "shot": "browse-filtered-390"
    },
    {
      "click": "[data-testid=\"category-chip\"][data-category=\"All\"]",
      "settleMs": 250
    },
    {
      "centre": "[data-testid=\"produce-card\"][data-id=\"p1\"]"
    },
    {
      "click": "[data-testid=\"produce-card\"][data-id=\"p1\"]",
      "settleMs": 350
    },
    {
      "shot": "detail-390"
    },
    {
      "measure": "detailTitle",
      "kind": "rest",
      "selector": "[data-testid=\"detail-title\"]",
      "sequence": [
        "open first record"
      ]
    },
    {
      "centre": "[data-testid=\"option-pickup\"][data-value=\"Today 5–7 PM\"]"
    },
    {
      "click": "[data-testid=\"option-pickup\"][data-value=\"Today 5–7 PM\"]",
      "settleMs": 250
    },
    {
      "measure": "optionSelected",
      "kind": "selected",
      "selector": "[data-testid=\"option-pickup\"][data-value=\"Today 5–7 PM\"]",
      "sequence": [
        "choose an option"
      ]
    },
    {
      "measure": "ctaRest",
      "kind": "rest",
      "selector": "[data-testid=\"reserve-btn\"]",
      "sequence": [
        "detail view, pointer away"
      ]
    },
    {
      "centre": "[data-testid=\"reserve-btn\"]"
    },
    {
      "hover": "[data-testid=\"reserve-btn\"]",
      "settleMs": 300
    },
    {
      "measure": "ctaHover",
      "kind": "hover",
      "selector": "[data-testid=\"reserve-btn\"]",
      "sequence": [
        "hover the primary action"
      ]
    },
    {
      "click": "[data-testid=\"reserve-btn\"]",
      "settleMs": 350
    },
    {
      "measure": "errorText",
      "kind": "error",
      "selector": "[data-testid=\"error-name\"]",
      "sequence": [
        "submit an empty form"
      ]
    },
    {
      "shot": "detail-errors-390"
    },
    {
      "setValues": [
        {
          "selector": "[data-testid=\"buyer-name\"]",
          "value": "Test Your name"
        },
        {
          "selector": "[data-testid=\"buyer-phone\"]",
          "value": "9876543210"
        }
      ]
    },
    {
      "centre": "[data-testid=\"reserve-btn\"]"
    },
    {
      "click": "[data-testid=\"reserve-btn\"]",
      "settleMs": 450
    },
    {
      "shot": "confirmation-390"
    },
    {
      "measure": "confirmRef",
      "kind": "post-action",
      "selector": "[data-testid=\"reserve-ref\"]",
      "sequence": [
        "complete a submission"
      ]
    },
    {
      "axe": "shop"
    },
    {
      "viewport": {
        "width": 1440,
        "height": 900
      }
    },
    {
      "click": "[data-act=\"nav\"][data-view=\"shop\"], [data-act=\"go\"][data-view=\"shop\"]",
      "settleMs": 350,
      "optional": true
    },
    {
      "shot": "browse-1440"
    },
    {
      "centre": "[data-testid=\"produce-card\"][data-id=\"p1\"]"
    },
    {
      "click": "[data-testid=\"produce-card\"][data-id=\"p1\"]",
      "settleMs": 300
    },
    {
      "shot": "detail-1440"
    },
    {
      "axe": "detail"
    }
  ]
}
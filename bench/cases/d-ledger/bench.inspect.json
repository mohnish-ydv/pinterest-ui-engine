{
  "id": "d-ledger-bench",
  "app": "app",
  "viewport": {
    "width": 390,
    "height": 844
  },
  "desktop": {
    "width": 1440,
    "height": 900
  },
  "derivedFrom": "layout IR v2 (planner 2.0.0)",
  "steps": [
    {
      "shot": "browse-390"
    },
    {
      "centre": "[data-testid=\"status-chip\"][data-status=\"Draft\"]"
    },
    {
      "click": "[data-testid=\"status-chip\"][data-status=\"Draft\"]",
      "settleMs": 250
    },
    {
      "measure": "chipSelected",
      "kind": "selected",
      "selector": "[data-testid=\"status-chip\"][data-status=\"Draft\"]",
      "sequence": [
        "select filter"
      ]
    },
    {
      "shot": "browse-filtered-390"
    },
    {
      "click": "[data-testid=\"status-chip\"][data-status=\"All\"]",
      "settleMs": 250
    },
    {
      "centre": "[data-testid=\"claim-card\"][data-id=\"k1\"]"
    },
    {
      "click": "[data-testid=\"claim-card\"][data-id=\"k1\"]",
      "settleMs": 350
    },
    {
      "shot": "detail-390"
    },
    {
      "measure": "detailTitle",
      "kind": "rest",
      "selector": "[data-testid=\"detail-title\"]",
      "sequence": [
        "open first record"
      ]
    },
    {
      "measure": "ctaRest",
      "kind": "rest",
      "selector": "[data-testid=\"file-btn\"]",
      "sequence": [
        "detail view, pointer away"
      ]
    },
    {
      "centre": "[data-testid=\"file-btn\"]"
    },
    {
      "hover": "[data-testid=\"file-btn\"]",
      "settleMs": 300
    },
    {
      "measure": "ctaHover",
      "kind": "hover",
      "selector": "[data-testid=\"file-btn\"]",
      "sequence": [
        "hover the primary action"
      ]
    },
    {
      "click": "[data-testid=\"file-btn\"]",
      "settleMs": 350
    },
    {
      "measure": "errorText",
      "kind": "error",
      "selector": "[data-testid=\"error-title\"]",
      "sequence": [
        "submit an empty form"
      ]
    },
    {
      "shot": "detail-errors-390"
    },
    {
      "setValues": [
        {
          "selector": "[data-testid=\"claim-title\"]",
          "value": "Test Claim title"
        },
        {
          "selector": "[data-testid=\"claim-amount\"]",
          "value": "2450"
        }
      ]
    },
    {
      "centre": "[data-testid=\"file-btn\"]"
    },
    {
      "click": "[data-testid=\"file-btn\"]",
      "settleMs": 450
    },
    {
      "shot": "confirmation-390"
    },
    {
      "measure": "confirmRef",
      "kind": "post-action",
      "selector": "[data-testid=\"file-ref\"]",
      "sequence": [
        "complete a submission"
      ]
    },
    {
      "axe": "claims"
    },
    {
      "viewport": {
        "width": 1440,
        "height": 900
      }
    },
    {
      "click": "[data-act=\"nav\"][data-view=\"claims\"], [data-act=\"go\"][data-view=\"claims\"]",
      "settleMs": 350,
      "optional": true
    },
    {
      "shot": "browse-1440"
    },
    {
      "centre": "[data-testid=\"claim-card\"][data-id=\"k1\"]"
    },
    {
      "click": "[data-testid=\"claim-card\"][data-id=\"k1\"]",
      "settleMs": 300
    },
    {
      "shot": "detail-1440"
    },
    {
      "axe": "detail"
    }
  ]
}
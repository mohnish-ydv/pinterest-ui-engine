{
  "app": "Herald",
  "entity": "dispatch",
  "entryView": "dispatches",
  "recordCount": 4,
  "derivedFrom": "layout IR v2 (planner 2.0.0)",
  "steps": [
    {
      "id": "T1",
      "desc": "the dispatches list renders all 4 records",
      "act": "count",
      "sel": "[data-testid=\"dispatch-card\"]",
      "eq": 4
    },
    {
      "id": "T2",
      "desc": "the collection container is present",
      "act": "visible",
      "sel": "[data-testid=\"dispatch-list\"]",
      "eq": true
    },
    {
      "id": "T3",
      "desc": "filtering by Section = Water shows 2",
      "act": "click",
      "sel": "[data-testid=\"section-chip\"][data-section=\"Water\"]"
    },
    {
      "id": "T4",
      "desc": "only 2 record(s) remain after filtering",
      "act": "count",
      "sel": "[data-testid=\"dispatch-card\"]",
      "eq": 2
    },
    {
      "id": "T5",
      "desc": "the filter chip reports pressed state",
      "act": "attr",
      "sel": "[data-testid=\"section-chip\"][data-section=\"Water\"]",
      "attr": "aria-pressed",
      "eq": "true"
    },
    {
      "id": "T6",
      "desc": "the All chip restores every record",
      "act": "click",
      "sel": "[data-testid=\"section-chip\"][data-section=\"All\"]"
    },
    {
      "id": "T7",
      "desc": "all records are back",
      "act": "count",
      "sel": "[data-testid=\"dispatch-card\"]",
      "eq": 4
    },
    {
      "id": "T8",
      "desc": "searching \"The well under the car park\" narrows to 1",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": "The well under the car park"
    },
    {
      "id": "T9",
      "desc": "search yields 1 record(s)",
      "act": "count",
      "sel": "[data-testid=\"dispatch-card\"]",
      "eq": 1
    },
    {
      "id": "T10",
      "desc": "clearing search restores every record",
      "act": "type",
      "sel": "[data-testid=\"search\"]",
      "value": ""
    },
    {
      "id": "T11",
      "desc": "all records are back after clearing search",
      "act": "count",
      "sel": "[data-testid=\"dispatch-card\"]",
      "eq": 4
    },
    {
      "id": "T12",
      "desc": "opening the first record shows its detail",
      "act": "click",
      "sel": "[data-testid=\"dispatch-card\"][data-id=\"d1\"]"
    },
    {
      "id": "T13",
      "desc": "the detail heading is the record title",
      "act": "text",
      "sel": "[data-testid=\"detail-title\"]",
      "eq": "The well under the car park"
    },
    {
      "id": "T14",
      "desc": "the detail view is the active view",
      "act": "attr",
      "sel": "#main",
      "attr": "data-view",
      "eq": "detail"
    },
    {
      "id": "T15",
      "desc": "no page or console errors occurred",
      "act": "console",
      "eq": 0
    }
  ]
}
{
  "$schema": "design-family/1",
  "borders": {
    "hairlineWidth": "1px",
    "stepperWidth": "1.5px",
    "focusRing": {
      "width": "3px",
      "offset": "2px",
      "color": "brand"
    },
    "hairline": "#EBDFCE",
    "stepperHairline": "#EBDFCE"
  },
  "surfaces": {
    "groundSource": "spec",
    "inputTextSource": "ink",
    "inputBg": "#F5EDDF"
  },
  "semantic": {
    "error": "spec",
    "warning": null,
    "success": "palette:cert"
  },
  "space": [
    4,
    8,
    12,
    16,
    20,
    24,
    32
  ],
  "responsive": {
    "breakpoint": 900,
    "mobile": "single column",
    "desktop": "multi-column, tab bar hidden"
  },
  "family": "market",
  "description": "Design world \"market\", derived from the brief: consumer product people browse and buy from: warm cream ground, a deep product-world brand, soft generous shapes and a display face with character.",
  "typography": {
    "displayStrategy": "serif",
    "displayStack": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, \"Times New Roman\", serif",
    "uiStack": "-apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "displayRoleNote": "serif display for headings; grotesque for UI"
  },
  "shadows": {
    "card": "0 8px 22px rgba(33,23,18,0.08)",
    "sheet": "0 -12px 32px rgba(33,23,18,0.10)"
  },
  "states": {
    "hoverTarget": "brandDeep",
    "disabled": {
      "bg": "#F5EDDF",
      "fg": "#6B6B6B"
    }
  },
  "density": {
    "lineHeight": 1.5,
    "bodyScale": 1
  }
}

    "chipOff": {
      "bg": "#FFFFFF",
      "fg": "#211712"
    },
    "badge": {
      "bg": "#EEDED5",
      "fg": "#6D2215"
    },
    "stepper": {
      "bg": "#FFFFFF",
      "fg": "#211712",
      "line": "#EBDFCE"
    },
    "tabActive": {
      "fg": "#8C2B1B"
    },
    "tabIdle": {
      "fg": "#5F5A56"
    },
    "priceOnDark": {
      "fg": "#FFFFFF"

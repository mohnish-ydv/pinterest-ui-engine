    "ink": "#211712",
    "inkSoft": "#5F5A56",
    "brand": "#8C2B1B",
    "brandDeep": "#6D2215",
    "tint": "#EEDED5",
    "star": "#E8A33D",
    "cert": "#1E5B3C",
    "onBrand": "#FFFFFF",
    "line": "#EBDFCE",
    "lineStrong": "#EBDFCE",
    "error": "#A32026",
    "warning": null,
    "success": "#1E5B3C",
    "input": "#F5EDDF",
    "inputText": "#211712"
  },
  "font": {
    "display": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, \"Times New Roman\", serif",
    "ui": "-apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
  },
  "type": {
    "body": 14,
    "display": 30,
    "section": 18,
    "small": 12,
    "amount": 15

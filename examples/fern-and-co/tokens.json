  "borders": {
    "hairlineWidth": "1px",
    "stepperWidth": "1.5px",
    "focusRing": {
      "width": "3px",
      "offset": "2px",
      "color": "brand"
    }
  },
  "responsive": {
    "breakpoint": 900,
    "mobile": "single column",
